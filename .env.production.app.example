# Copy this file to .env.production.app on the VPS and keep that file out of Git.
#   chmod 600 .env.production.app
#
# Loaded as env_file by api and worker only - the two services that call external APIs. The Web
# host deliberately does not load it, so the external API key and the Discord webhook never reach
# the internet-facing service. Add new application secrets here, not to .env.production.
#
# The path is chosen by APP_ENV_FILE in .env.production.

# Keep Mock until the API contract, credit consumption, and Secret are confirmed.
# Mock is also the built-in default, so a missing file cannot silently start spending credit.
RakkoKeyword__Mode=Mock
RakkoKeyword__BaseUrl=https://api.rakkokeyword.com
# Required when RakkoKeyword__Mode=Real.
# RakkoKeyword__ApiKeySecretRef=rakko-keyword-api-key-prod
# Secrets__rakko-keyword-api-key-prod=<API key>

SecretStore__Provider=Configuration
SecretStore__ConfigurationPrefix=Secrets

# The Configuration Secret Store reads process configuration only. Secrets registered through the
# admin API live in that process alone: they are lost on restart and are not shared between api and
# worker. Anything that must survive a restart belongs here as Secrets__<reference name>, so both
# services resolve the same value.
Discord__DefaultWebhookSecretName=discord-webhook-prod
# Secrets__discord-webhook-prod=<Discord webhook URL>
