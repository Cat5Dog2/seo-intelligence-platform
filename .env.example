# Copy this file to .env for local development. Do not commit .env.

SecretStore__Provider=Configuration
SecretStore__ConfigurationPrefix=Secrets

# Optional Docker Compose overrides. Defaults are shown below.
# POSTGRES_DB=seo
# POSTGRES_USER=seo
# POSTGRES_PASSWORD=seo_dev_password
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# API_PORT=5251
# WEB_PORT=5295
# HANGFIRE_WORKER_COUNT=4

# Discord Webhook URL secret. Keep the real URL only in .env or an external Secret Store.
Discord__DefaultWebhookSecretName=discord-webhook-dev
# Secrets__discord-webhook-dev=https://discord.com/api/webhooks/...

# Optional smoke-test inputs.
# SMOKE_DISCORD_CHANNEL_ID=00000000-0000-0000-0000-000000000000
# SMOKE_PROJECT_ID=00000000-0000-0000-0000-000000000000

# Optional browser E2E inputs. tests/E2ETests loads .env automatically.
# scripts/smoke-local.ps1 -RunBrowserTests sets all of these itself, so they are only needed to
# run `dotnet test` against an already-running stack. Enabling E2E_BROWSER_ENABLED without the
# service key and administrator credentials makes the browser smoke test fail rather than skip.
# E2E_BROWSER_ENABLED=true
# E2E_WEB_URL=http://localhost:5295
# E2E_API_URL=http://localhost:5251
# Must match Secrets__ApiServiceKey; the API rejects calls without it.
# E2E_API_SERVICE_KEY=local_development_service_key
# Must match AdminSeed__Email / AdminSeed__Password.
# E2E_ADMIN_EMAIL=developer@localhost
# E2E_ADMIN_PASSWORD=LocalDev!Passw0rd
# E2E_HEADLESS=false
