# Copy this file to .env.production on the VPS and keep that file out of Git.
# Every production command passes both files explicitly:
#   docker compose --env-file .env.production -f compose.yaml -f compose.production.yaml <command>

# Makes api/worker load this same file as their env_file.
APP_ENV_FILE=.env.production

POSTGRES_DB=seo
POSTGRES_USER=seo
# Required. Any characters are safe (the application composes the connection
# string in code); a generated value is still recommended: openssl rand -hex 32
POSTGRES_PASSWORD=

# Dedicated external network shared only by this stack and the common Caddy container.
CADDY_NETWORK=seo-intelligence-caddy

# Keep Mock until the API contract, credit consumption, and Secret are confirmed.
RakkoKeyword__Mode=Mock
RakkoKeyword__BaseUrl=https://api.rakkokeyword.com
# RakkoKeyword__ApiKeySecretRef=rakko-keyword-api-key-prod
# Secrets__rakko-keyword-api-key-prod=<API key>

SecretStore__Provider=Configuration
SecretStore__ConfigurationPrefix=Secrets
Discord__DefaultWebhookSecretName=discord-webhook-prod
# Secrets__discord-webhook-prod=<Discord webhook URL>

# Required. Shared secret the Web host presents to the API on every call; the API
# rejects everything else. Generate with: openssl rand -hex 32
API_SERVICE_KEY=

# Required on the FIRST deploy only. Creates the initial administrator when no Admin
# user exists yet; the Web host refuses to start in that state if these are empty, so a
# deployment can never end up healthy but impossible to sign in to.
# The password must be at least 12 characters and contain an upper-case letter, a
# lower-case letter, a digit, and a symbol.
# After the first sign-in, change the password from the account screen and clear these
# values again. Once an Admin exists the seed is skipped, so leaving them empty is
# expected and every later Compose operation still works.
# Do not delete the AdminSeed lines from compose.production.yaml: that would fall back
# to the development defaults in compose.yaml.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_DISPLAY_NAME=Admin

# Optional Worker concurrency override.
HANGFIRE_WORKER_COUNT=4
