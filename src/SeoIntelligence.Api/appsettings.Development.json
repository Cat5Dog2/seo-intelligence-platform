{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "EventLog": {
      "LogLevel": {
        "Default": "None"
      }
    }
  },
  "ConnectionStrings": {
    "Default": "Host=127.0.0.1;Port=5432;Database=seo;Username=seo;Password=seo_dev_password"
  },
  "Redis": {
    "ConnectionString": "127.0.0.1:6379"
  },
  "Storage": {
    "Provider": "Local",
    "BasePath": "./.data/storage",
    "Endpoint": "http://127.0.0.1:9000",
    "BucketName": "seo-intelligence"
  },
  "SecretStore": {
    "Provider": "Configuration",
    "ConfigurationPrefix": "Secrets"
  },
  "ServiceAuthentication": {
    "ServiceKeyRef": "ApiServiceKey"
  },
  "Secrets": {
    "ApiServiceKey": "local-development-service-key"
  },
  "OpenTelemetry": {
    "Enabled": false,
    "ServiceName": "SeoIntelligence.Api"
  }
}
