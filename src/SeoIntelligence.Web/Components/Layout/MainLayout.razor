@inherits LayoutComponentBase

<div class="app-shell">
    <header class="app-header">
        <a class="brand" href="/">SEO Intelligence</a>
        <div class="header-controls">
            <ProjectSwitcher />
            <details class="header-settings">
                <summary>地域・言語の設定</summary>
                <div class="header-settings-content"><LocationLanguageSelector /></div>
            </details>
            <div class="header-usage"><CreditBadge /></div>
            <AuthorizeView>
                <Authorized>
                    @if (GuestAuthentication.IsGuest(context.User))
                    {
                        <span class="guest-mode-badge">ゲスト・Mock</span>
                    }
                    <a class="account-link" href="/account">@context.User.Identity?.Name</a>
                    <form method="post" action="/logout" class="logout-form">
                        <AntiforgeryToken />
                        <button type="submit" class="btn-link">ログアウト</button>
                    </form>
                </Authorized>
            </AuthorizeView>
        </div>
    </header>

    <div class="app-frame">
        <button type="button" class="mobile-nav-toggle" aria-expanded="@IsMenuOpen.ToString().ToLowerInvariant()" aria-controls="main-navigation" @onclick="() => IsMenuOpen = !IsMenuOpen">@(IsMenuOpen ? "メニューを閉じる" : "メニューを開く")</button>
        <nav id="main-navigation" class="side-nav @(IsMenuOpen ? "is-open" : "")" aria-label="メインメニュー" @onclick="() => IsMenuOpen = false">
            <div class="nav-group">
            <NavLink href="/" Match="NavLinkMatch.All">プロジェクト</NavLink>
            <NavLink href="/dashboard">ダッシュボード</NavLink>
            </div>
            <div class="nav-group" aria-labelledby="nav-research">
            <h2 id="nav-research">調査・分析</h2>
            <NavLink href="/keywords">キーワード</NavLink>
            <NavLink href="/search-volume">検索ボリューム</NavLink>
            <NavLink href="/competitors">競合分析</NavLink>
            <NavLink href="/influx">獲得語/ページ</NavLink>
            <NavLink href="/content-analysis">コンテンツ分析</NavLink>
            </div>
            <div class="nav-group" aria-labelledby="nav-content">
            <h2 id="nav-content">コンテンツ</h2>
            <NavLink href="/clusters">トピッククラスター</NavLink>
            <NavLink href="/briefs">記事ブリーフ</NavLink>
            <NavLink href="/rewrite">リライト管理</NavLink>
            <NavLink href="/ai-assistant">AIアシスタント</NavLink>
            </div>
            <div class="nav-group" aria-labelledby="nav-monitoring">
            <h2 id="nav-monitoring">監視・レポート</h2>
            <NavLink href="/rank-monitoring">順位監視</NavLink>
            <NavLink href="/reports">レポート</NavLink>
            </div>
            <AuthorizeView Policy="@ApplicationPolicies.RequireAdmin">
                <Authorized>
                    <div class="nav-group" aria-labelledby="nav-admin">
                    <h2 id="nav-admin">管理</h2>
                    <NavLink href="/admin">管理</NavLink>
                    </div>
                </Authorized>
            </AuthorizeView>
        </nav>

        <main class="main-content">
            <AuthorizeView>
                <Authorized>
                    @if (GuestAuthentication.IsGuest(context.User))
                    {
                        <aside class="guest-demo-notice" aria-label="ゲストデモのご案内">
                            <strong>ゲスト・Mockモード</strong>
                            <p>プロジェクト・サイト編集、キーワード探索、検索ボリューム調査、CSV出力を試せます。その他の分析画面はサンプルの閲覧用です。</p>
                            <p>データはこのゲストセッション専用です。通常データへのアクセスや外部APIの通信は行いません。ログアウト・1時間経過・サーバー再起動で初期化されます。</p>
                        </aside>
                    }
                </Authorized>
            </AuthorizeView>
            @Body
        </main>
    </div>
</div>

@code {
    private bool IsMenuOpen { get; set; }
}

<div id="blazor-error-ui" data-nosnippet>
    接続または処理に問題が発生しました。
    <a href="." class="reload">再読み込み</a>
    <span class="dismiss">🗙</span>
</div>
