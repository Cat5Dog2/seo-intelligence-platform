@inherits WorkspaceComponentBase
@implements IDisposable
@inject ISeoIntelligenceApiClient ApiClient
@inject ProjectSelectionState ProjectState

<section class="job-panel">
    <div class="section-heading compact-heading">
        <h2>@Title</h2>
        <button type="button" class="icon-button text-button" title="ジョブを再読み込み" @onclick="LoadAsync">更新</button>
    </div>
    <ErrorSummary Errors="@Errors" />
    <DataTable Items="@Jobs" Columns="@JobColumns" MobileCards="true" IsLoading="@IsLoading" EmptyText="ジョブはありません。">
        <RowActions Context="job">
            <div class="row-actions">
                @if (!IsGuest && CanRetry(job))
                {
                    <button type="button" class="table-action" @onclick="() => RetryAsync(job.JobId)">再実行</button>
                }
                @if (!IsGuest && CanCancel(job))
                {
                    <button type="button" class="table-action" @onclick="() => CancelAsync(job.JobId)">キャンセル</button>
                }
                @if (DownloadHref(job) is { } downloadHref)
                {
                    <a class="table-action" data-testid="job-download-link" href="@downloadHref" target="_top">ダウンロード</a>
                }
                @ResultActions?.Invoke(job)
                <AuditLink ResourceType="job" ResourceId="@job.JobId.ToString("D")" />
            </div>
        </RowActions>
    </DataTable>
</section>

@code {
    private static readonly IReadOnlyList<DataTableColumn<JobDetails>> JobColumns =
    [
        new("種別", job => UiText.JobType(job.JobType)),
        new("状態", job => UiText.Status(job.Status), "table-status"),
        new("進捗", job => $"{job.Progress}%"),
        new("再試行", job => job.RetryCount.ToString()),
        new("更新", job => FormatDateTime(job.UpdatedAt))
    ];

    [Parameter]
    public int PageSize { get; set; } = 25;

    [Parameter]
    public string Title { get; set; } = "ジョブ";

    [Parameter]
    public string Status { get; set; } = "all";

    [Parameter]
    public bool ProjectScoped { get; set; } = true;

    [Parameter]
    public string? JobType { get; set; }

    [Parameter]
    public RenderFragment<JobDetails>? ResultActions { get; set; }

    [Parameter]
    public EventCallback OnRefreshed { get; set; }

    private int LoadVersion { get; set; }

    private IReadOnlyList<JobDetails> Jobs { get; set; } = [];

    private IReadOnlyList<ApiError> Errors { get; set; } = [];

    private bool IsLoading { get; set; }

    private string? LoadedJobType { get; set; }

    private string? LoadedStatus { get; set; }

    private bool? LoadedProjectScoped { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        ProjectState.Changed += OnProjectStateChanged;
        await LoadAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!string.Equals(LoadedJobType, JobType, StringComparison.Ordinal) ||
            !string.Equals(LoadedStatus, Status, StringComparison.Ordinal) ||
            LoadedProjectScoped != ProjectScoped)
        {
            await LoadAsync();
        }
    }

    public async Task RefreshAsync()
    {
        await LoadAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadAsync()
    {
        IsLoading = true;
        Errors = [];
        var loadVersion = ++LoadVersion;
        var projectId = ProjectScoped ? ProjectState.SelectedProject?.ProjectId : null;
        if (ProjectScoped && projectId is null)
        {
            Jobs = [];
            IsLoading = false;
            return;
        }
        var result = await ApiClient.SearchJobsAsync(status: Status, jobType: JobType, projectId: projectId, pageSize: PageSize);
        if (loadVersion != LoadVersion || (ProjectScoped && projectId != ProjectState.SelectedProject?.ProjectId))
        {
            return;
        }
        if (result.IsSuccess)
        {
            Jobs = result.Data ?? [];
        }
        else
        {
            Jobs = [];
            Errors = result.Errors;
        }

        IsLoading = false;
        LoadedJobType = JobType;
        LoadedStatus = Status;
        LoadedProjectScoped = ProjectScoped;
        if (result.IsSuccess)
        {
            await OnRefreshed.InvokeAsync();
        }
    }

    private async Task RetryAsync(Guid jobId)
    {
        var result = await ApiClient.RetryJobAsync(jobId);
        Errors = result.IsSuccess ? [] : result.Errors;
        await LoadAsync();
    }

    private async Task CancelAsync(Guid jobId)
    {
        var result = await ApiClient.CancelJobAsync(jobId);
        Errors = result.IsSuccess ? [] : result.Errors;
        await LoadAsync();
    }

    private async void OnProjectStateChanged()
    {
        await InvokeAsync(async () =>
        {
            await LoadAsync();
            StateHasChanged();
        });
    }

    private static bool CanRetry(JobDetails job)
        => string.Equals(job.Status, "failed_retryable", StringComparison.OrdinalIgnoreCase)
            || string.Equals(job.Status, "succeeded", StringComparison.OrdinalIgnoreCase);

    private static bool CanCancel(JobDetails job)
        => string.Equals(job.Status, "queued", StringComparison.OrdinalIgnoreCase)
            || string.Equals(job.Status, "waiting_external", StringComparison.OrdinalIgnoreCase);

    private static string? DownloadHref(JobDetails job)
        => ArtifactDownloadLinks.ForJob(job);

    private static string FormatDateTime(DateTime value)
        => value.ToLocalTime().ToString("yyyy-MM-dd HH:mm");

    public void Dispose()
    {
        LoadVersion++;
        ProjectState.Changed -= OnProjectStateChanged;
    }
}
