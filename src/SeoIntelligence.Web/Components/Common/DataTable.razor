@typeparam TItem

@if (HasVisibleTable)
{
    <p class="table-scroll-hint @(MobileCards ? "desktop-table-hint" : "")">表は横にスクロールできます。@(RowActions is null ? "" : "右端に操作ボタンがあります。")</p>
}
<div class="data-table-wrap" tabindex="@(HasVisibleTable ? 0 : -1)" role="region" aria-label="データ一覧">
    @if (IsLoading)
    {
        <div class="state-row">読み込み中</div>
    }
    else if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="state-row state-row-error">@ErrorMessage</div>
    }
    else if (Items.Count == 0)
    {
        <div class="state-row">@EmptyText</div>
    }
    else
    {
        <table class="data-table @(MobileCards ? "mobile-cards" : "")">
            <thead>
                <tr>
                    @foreach (var column in Columns)
                    {
                        <th class="@column.CssClass">@column.Header</th>
                    }
                    @if (RowActions is not null)
                    {
                        <th class="actions-column">操作</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Items)
                {
                    <tr>
                        @for (var index = 0; index < Columns.Count; index++)
                        {
                            var column = Columns[index];
                            <td class="@column.CssClass @(index == 0 ? "card-title" : index < 3 ? "card-metric" : "card-secondary")" data-label="@column.Header">@column.Cell(item)</td>
                        }
                        @if (MobileCards && Columns.Count > 3)
                        {
                            <td class="mobile-card-details">
                                <details>
                                    <summary aria-label="@(Columns[0].Cell(item) + "の詳細")">詳細</summary>
                                    <dl>
                                        @foreach (var column in Columns.Skip(3))
                                        {
                                            <div><dt>@column.Header</dt><dd>@(column.Cell(item) ?? "—")</dd></div>
                                        }
                                    </dl>
                                </details>
                            </td>
                        }
                        @if (RowActions is not null)
                        {
                            <td class="actions-column">@RowActions(item)</td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private bool HasVisibleTable => !IsLoading && string.IsNullOrWhiteSpace(ErrorMessage) && Items.Count > 0;

    [Parameter]
    public bool MobileCards { get; set; }

    [Parameter]
    public IReadOnlyList<TItem> Items { get; set; } = [];

    [Parameter]
    public IReadOnlyList<DataTableColumn<TItem>> Columns { get; set; } = [];

    [Parameter]
    public RenderFragment<TItem>? RowActions { get; set; }

    [Parameter]
    public bool IsLoading { get; set; }

    [Parameter]
    public string? ErrorMessage { get; set; }

    [Parameter]
    public string EmptyText { get; set; } = "表示できるデータはありません。";
}
