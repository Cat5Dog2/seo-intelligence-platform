@page "/briefs"
@attribute [Authorize(Policy = ApplicationPolicies.RequireWorkspaceAccess)]
@using System.Text.Json
@inherits WorkspaceComponentBase
@implements IDisposable
@inject ISeoIntelligenceApiClient ApiClient
@inject ProjectSelectionState ProjectState

<PageTitle>記事ブリーフ - SEO Intelligence</PageTitle>

<div class="page-stack">
    <header class="page-header">
        <div>
            <h1>記事ブリーフ</h1>
            <p class="project-context">選択中プロジェクト: @(ProjectState.SelectedProject?.Name ?? "未選択")</p>
        </div>
        <div class="toolbar">
            <button type="button" class="secondary-button" @onclick="LoadAsync" disabled="@(ProjectState.SelectedProject is null)">更新</button>
        </div>
    </header>

    @if (IsGuest)
    {
        <GuestReadOnlyNotice />
    }
    <ErrorSummary Errors="@Errors" />
    @if (!ProjectState.IsLoading && ProjectState.SelectedProject is null && ProjectState.ErrorMessage is null)
    {
        <GettingStarted />
    }
    @if (!string.IsNullOrWhiteSpace(Message))
    {
        <div class="state-row">@Message</div>
    }

    @if (!IsGuest && SelectedBrief is null)
    {
        <section class="panel">
            <div class="section-heading">
                <h2>生成条件</h2>
                <span class="muted">根拠データに基づく下書き</span>
            </div>
            <p class="muted">未取得の集客コンテンツ・見出し・共起語を外部APIから取得します。APIクレジットを消費する場合があります。生成後は内容を確認して保存してください。</p>
            <div class="form-grid dense-form">
                <label class="field wide-field">
                    <span>対象キーワード</span>
                    <input @bind="GenerateForm.TargetKeyword" @bind:event="oninput" disabled="@(ProjectState.SelectedProject is null)" />
                </label>
                <label class="field wide-field">
                    <span>タイトル</span>
                    <input @bind="GenerateForm.Title" disabled="@(ProjectState.SelectedProject is null)" />
                </label>
                <label class="field">
                    <span>クラスターID（任意）</span>
                    <input @bind="GenerateForm.ClusterId" disabled="@(ProjectState.SelectedProject is null)" />
                </label>
                <label class="field wide-field">
                    <span>競合URL（改行区切り）</span>
                    <textarea @bind="GenerateForm.CompetitorUrls" disabled="@(ProjectState.SelectedProject is null)"></textarea>
                </label>
                <button type="button" class="primary-button" @onclick="GenerateAsync" disabled="@(!CanOperate)">生成ジョブ登録</button>
            </div>
        </section>

        <JobProgressPanel Title="ブリーフ生成ジョブ" JobType="GenerateBriefJob" OnRefreshed="LoadAsync" />

    }

    <section class="page-stack brief-workspace">
        @if (SelectedBrief is null)
        {
        <div class="panel">
            <div class="section-heading">
                <h2>ブリーフ一覧</h2>
            </div>
            <details class="result-filters">
                <summary>絞り込み@(string.IsNullOrWhiteSpace(Query) ? "" : $" · {Query}")@(string.IsNullOrWhiteSpace(ReviewStatusFilter) ? "" : $" · {UiText.ReviewStatus(ReviewStatusFilter)}")</summary>
                <div class="toolbar">
                    <label class="field-inline">
                        <span>検索</span>
                        <input @bind="Query" @bind:event="oninput" disabled="@(ProjectState.SelectedProject is null)" />
                    </label>
                    <label class="field-inline">
                        <span>レビュー状態</span>
                        <select @bind="ReviewStatusFilter" disabled="@(ProjectState.SelectedProject is null)">
                            <option value="">すべて</option>
                            <option value="pending">確認待ち</option>
                            <option value="reviewed">確認済み</option>
                            <option value="rejected">差し戻し</option>
                        </select>
                    </label>
                    <button type="button" class="secondary-button" @onclick="LoadAsync" disabled="@(ProjectState.SelectedProject is null)">検索</button>
                </div>
            </details>
            @if (IsLoading) { <div class="state-row" role="status">読み込み中</div> }
            else if (Briefs.Count == 0) { <div class="state-row">記事ブリーフはありません。</div> }
            else
            {
                <ul class="brief-list">
                    @foreach (var brief in Briefs)
                    {
                        <li>
                            <div><h3>@brief.Title</h3><p>@brief.TargetKeyword · 第@(brief.CurrentVersion)版 · @FormatDateTime(brief.UpdatedAt)</p></div>
                            <span class="status-pill">@UiText.ReviewStatus(brief.ReviewStatus)</span>
                            <button type="button" class="secondary-button" @onclick="() => SelectBriefAsync(brief.BriefId)">詳細</button>
                        </li>
                    }
                </ul>
            }
        </div>

        }
        else
        {
        <div class="panel" id="brief-detail">
            <div class="section-heading">
                <h2>@SelectedBrief.Title</h2>
                <button type="button" class="text-button" @onclick="CloseBrief">一覧に戻る</button>
                <div class="toolbar">
                    @if (!IsGuest)
                    {
                        <button type="button" class="primary-button" @onclick="SaveAsync" disabled="@(SelectedBrief is null)">保存</button>
                    }
                    @if (!IsGuest)
                    {
                        <button type="button" class="secondary-button" @onclick="RegenerateWithAiAsync" disabled="@(SelectedBrief is null || IsAiRegenerating)">AI再生成</button>
                    }
                    @if (!IsGuest)
                    {
                        <button type="button" class="secondary-button" @onclick="ExportMarkdownAsync" disabled="@(SelectedBrief is null)">Markdown出力</button>
                    }
                    @if (!IsGuest)
                    {
                        <button type="button" class="secondary-button" @onclick="ExportCsvAsync" disabled="@(SelectedBrief is null)">CSV出力</button>
                    }
                </div>
            </div>
            @if (SelectedBrief is null)
            {
                <div class="state-row">ブリーフを選択してください。</div>
            }
            else
            {
                <BriefContentView Content="@SelectedBrief.Content" />
                @if (!IsGuest)
                {
                <fieldset class="form-grid dense-form">
                    <legend>編集</legend>
                    <label class="field wide-field">
                        <span>タイトル</span>
                        <input @bind="EditForm.Title" />
                    </label>
                    <label class="field">
                        <span>レビュー状態</span>
                        <select @bind="EditForm.ReviewStatus">
                            <option value="pending">確認待ち</option>
                            <option value="reviewed">確認済み</option>
                            <option value="rejected">差し戻し</option>
                        </select>
                    </label>
                    <label class="field">
                        <span>状態</span>
                        <select @bind="EditForm.Status">
                            <option value="draft">下書き</option>
                            <option value="active">有効</option>
                            <option value="archived">アーカイブ済み</option>
                        </select>
                    </label>
                    <label class="field wide-field">
                        <span>変更メモ</span>
                        <input @bind="EditForm.ChangeSummary" />
                    </label>
                </fieldset>
                }
                <details class="advanced-options">
                    <summary>詳細データ（JSON）</summary>
                    <p class="muted">保存済みの本文データです。通常ログインでは編集して保存できます。</p>
                    <label class="field json-field">
                        <span>本文データ（JSON）</span>
                        <textarea @bind="EditForm.ContentJson" readonly="@IsGuest"></textarea>
                    </label>
                </details>

                <div class="detail-list">
                    <div><span>レビュー状態</span><strong>@UiText.ReviewStatus(SelectedBrief.ReviewStatus)</strong></div>
                    <div><span>状態</span><strong>@UiText.Status(SelectedBrief.Status)</strong></div>
                    <div><span>対象キーワード</span><strong>@(SelectedBrief.TargetKeyword ?? "-")</strong></div>
                    <div><span>版</span><strong>@SelectedBrief.CurrentVersion</strong></div>
                    <div><span>更新日時</span><strong>@FormatDateTime(SelectedBrief.UpdatedAt)</strong></div>
                </div>

                @if (AiRegeneration is not null)
                {
                    <div class="form-grid dense-form">
                        <label class="field wide-field">
                            <span>AIの応答</span>
                            <textarea readonly>@AiRegeneration.Response</textarea>
                        </label>
                        <label class="field">
                            <span>レビュー状態</span>
                            <input readonly value="@UiText.ReviewStatus(AiRegeneration.ReviewStatus)" />
                        </label>
                        <label class="field">
                            <span>機密情報の除去</span>
                            <input readonly value="@AiRegeneration.RedactionStatus" />
                        </label>
                        <label class="field wide-field json-field">
                            <span>トークン使用量（JSON）</span>
                            <textarea readonly>@FormatJson(AiRegeneration.TokenUsage)</textarea>
                        </label>
                    </div>
                }

                <h3 class="subsection-title">版履歴</h3>
                <DataTable Items="@Versions" Columns="@VersionColumns" IsLoading="@IsVersionLoading" EmptyText="版履歴はありません。" />
            }
        </div>
        }
    </section>
</div>

@code {
    private static readonly JsonSerializerOptions JsonOptions = new(JsonSerializerDefaults.Web)
    {
        WriteIndented = true,
        Encoder = System.Text.Encodings.Web.JavaScriptEncoder.Create(System.Text.Unicode.UnicodeRanges.All)
    };

    private static readonly IReadOnlyList<DataTableColumn<ArticleBriefVersionDetails>> VersionColumns =
    [
        new("版", row => row.VersionNo.ToString(), "table-number"),
        new("レビュー状態", row => UiText.ReviewStatus(row.ReviewStatus), "table-status"),
        new("概要", row => row.ChangeSummary),
        new("作成日時", row => FormatDateTime(row.CreatedAt))
    ];

    private IReadOnlyList<ArticleBriefSummary> Briefs { get; set; } = [];

    private ArticleBriefDetails? SelectedBrief { get; set; }

    private IReadOnlyList<ArticleBriefVersionDetails> Versions { get; set; } = [];

    private AiChatResponse? AiRegeneration { get; set; }

    private IReadOnlyList<ApiError> Errors { get; set; } = [];

    private string? Message { get; set; }

    private GenerateBriefFormModel GenerateForm { get; set; } = new();

    private BriefEditFormModel EditForm { get; set; } = new();

    private bool IsLoading { get; set; }

    private bool IsVersionLoading { get; set; }

    private bool IsGenerating { get; set; }

    private bool IsAiRegenerating { get; set; }

    private string? Query { get; set; }

    private string? ReviewStatusFilter { get; set; }

    private Guid? SelectedProjectId { get; set; }
    private int ProjectVersion { get; set; }
    private int ListVersion { get; set; }
    private int SelectionVersion { get; set; }

    private bool CanOperate
        => !IsGuest && ProjectState.SelectedProject is not null && !IsGenerating;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        ProjectState.Changed += OnProjectStateChanged;
        await ProjectState.LoadAsync();
        SelectedProjectId = ProjectState.SelectedProject?.ProjectId;
        await LoadAsync();
    }

    private void CloseBrief()
    {
        ++SelectionVersion;
        SelectedBrief = null;
        Versions = [];
        AiRegeneration = null;
        EditForm = new();
    }

    private async Task GenerateAsync()
    {
        if (IsGuest) return;
        if (ProjectState.SelectedProject is not { } project)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(GenerateForm.TargetKeyword))
        {
            Errors = [new ApiError("Validation.TargetKeyword.Required", "対象キーワードを入力してください。", "targetKeyword")];
            return;
        }

        var clusterId = ParseNullableGuid(GenerateForm.ClusterId, "clusterId");
        if (Errors.Count > 0)
        {
            return;
        }

        IsGenerating = true;
        var projectVersion = ProjectVersion;
        Errors = [];
        Message = null;
        var result = await ApiClient.GenerateBriefAsync(
            project.ProjectId,
            new GenerateBriefRequest(
                TargetKeyword: GenerateForm.TargetKeyword.Trim(),
                ClusterId: clusterId,
                Title: Optional(GenerateForm.Title),
                CompetitorUrls: ParseLines(GenerateForm.CompetitorUrls)));
        if (!IsCurrentProject(projectVersion, project.ProjectId)) return;
        if (result.IsSuccess && result.Data is { } job)
        {
            Message = $"記事ブリーフ生成ジョブを登録しました: {job.JobId:D}";
            await LoadAsync();
        }
        else
        {
            Errors = result.Errors;
        }

        IsGenerating = false;
    }

    private async Task LoadAsync()
    {
        if (ProjectState.SelectedProject is not { } project)
        {
            Briefs = [];
            SelectedBrief = null;
            Versions = [];
            return;
        }

        IsLoading = true;
        var projectVersion = ProjectVersion;
        var listVersion = ++ListVersion;
        Errors = [];
        var result = await ApiClient.GetBriefsAsync(
            project.ProjectId,
            Query,
            reviewStatus: ReviewStatusFilter,
            pageSize: 100);
        if (!IsCurrentProject(projectVersion, project.ProjectId) || listVersion != ListVersion) return;
        if (result.IsSuccess)
        {
            Briefs = result.Data ?? [];
        }
        else
        {
            Briefs = [];
            Errors = result.Errors;
        }

        IsLoading = false;
    }

    private async Task SelectBriefAsync(Guid briefId)
    {
        if (ProjectState.SelectedProject is not { } project)
        {
            return;
        }

        Errors = [];
        SelectedBrief = null;
        Versions = [];
        AiRegeneration = null;
        IsAiRegenerating = false;
        IsVersionLoading = false;
        var projectVersion = ProjectVersion;
        var selectionVersion = ++SelectionVersion;
        var result = await ApiClient.GetBriefAsync(project.ProjectId, briefId);
        if (!IsCurrentProject(projectVersion, project.ProjectId) || selectionVersion != SelectionVersion) return;
        if (result.IsSuccess && result.Data is { } brief)
        {
            SelectedBrief = brief;
            AiRegeneration = null;
            EditForm = new BriefEditFormModel
            {
                Title = brief.Title,
                ReviewStatus = brief.ReviewStatus,
                Status = brief.Status,
                ContentJson = FormatJson(brief.Content)
            };
            await LoadVersionsAsync(brief.BriefId);
        }
        else
        {
            SelectedBrief = null;
            AiRegeneration = null;
            Versions = [];
            Errors = result.Errors;
        }
    }

    private async Task SaveAsync()
    {
        if (IsGuest) return;
        if (ProjectState.SelectedProject is not { } project || SelectedBrief is null || SelectedBrief.ProjectId != project.ProjectId)
        {
            return;
        }

        Errors = [];
        var content = ParseJson(EditForm.ContentJson, "content");
        if (Errors.Count > 0)
        {
            return;
        }

        Errors = [];
        Message = null;
        var projectVersion = ProjectVersion;
        var selectionVersion = SelectionVersion;
        var result = await ApiClient.UpdateBriefAsync(
            project.ProjectId,
            SelectedBrief.BriefId,
            new ArticleBriefUpdateRequest(
                EditForm.Title,
                content,
                EditForm.ReviewStatus,
                EditForm.Status,
                EditForm.ChangeSummary));
        if (!IsCurrentProject(projectVersion, project.ProjectId) || selectionVersion != SelectionVersion) return;
        if (result.IsSuccess && result.Data is { } updated)
        {
            Message = "保存しました。";
            SelectedBrief = updated;
            EditForm.ContentJson = FormatJson(updated.Content);
            await LoadAsync();
            if (IsCurrentProject(projectVersion, project.ProjectId) && selectionVersion == SelectionVersion)
                await LoadVersionsAsync(updated.BriefId);
        }
        else
        {
            Errors = result.Errors;
        }
    }

    private async Task ExportAsync(string format)
    {
        if (IsGuest) return;
        if (ProjectState.SelectedProject is not { } project || SelectedBrief is null || SelectedBrief.ProjectId != project.ProjectId)
        {
            return;
        }

        Errors = [];
        Message = null;
        var projectVersion = ProjectVersion;
        var selectionVersion = SelectionVersion;
        var result = await ApiClient.ExportBriefAsync(
            project.ProjectId,
            SelectedBrief.BriefId,
            new ArticleBriefExportRequest(format));
        if (!IsCurrentProject(projectVersion, project.ProjectId) || selectionVersion != SelectionVersion) return;
        if (result.IsSuccess && result.Data is { } job)
        {
            Message = $"{format}出力ジョブを登録しました: {job.JobId:D}";
        }
        else
        {
            Errors = result.Errors;
        }
    }

    private Task ExportMarkdownAsync()
        => ExportAsync("markdown");

    private Task ExportCsvAsync()
        => ExportAsync("csv");

    private async Task RegenerateWithAiAsync()
    {
        if (IsGuest) return;
        if (ProjectState.SelectedProject is not { } project || SelectedBrief is null || SelectedBrief.ProjectId != project.ProjectId)
        {
            return;
        }

        IsAiRegenerating = true;
        var projectVersion = ProjectVersion;
        var selectionVersion = SelectionVersion;
        Errors = [];
        Message = null;
        var referenceScope = JsonSerializer.SerializeToElement(
            new
            {
                type = "article_brief",
                briefId = SelectedBrief.BriefId,
                title = SelectedBrief.Title,
                targetKeyword = SelectedBrief.TargetKeyword,
                currentVersion = SelectedBrief.CurrentVersion
            },
            JsonOptions);
        var result = await ApiClient.ChatWithAiAsync(
            project.ProjectId,
            new AiChatRequest(
                $"記事ブリーフ「{SelectedBrief.Title}」を再生成してください。",
                AllowedTools: ["brief.regenerate"],
                ReferenceScope: referenceScope));
        if (!IsCurrentProject(projectVersion, project.ProjectId) || selectionVersion != SelectionVersion) return;
        if (result.IsSuccess && result.Data is { } response)
        {
            AiRegeneration = response;
            Message = $"AI再生成ジョブを登録しました: {response.JobId:D}";
        }
        else
        {
            AiRegeneration = null;
            Errors = result.Errors;
        }

        IsAiRegenerating = false;
    }

    private async Task LoadVersionsAsync(Guid briefId)
    {
        if (ProjectState.SelectedProject is not { } project)
        {
            return;
        }

        IsVersionLoading = true;
        var projectVersion = ProjectVersion;
        var selectionVersion = SelectionVersion;
        var result = await ApiClient.GetBriefVersionsAsync(project.ProjectId, briefId, pageSize: 50);
        if (!IsCurrentProject(projectVersion, project.ProjectId) || selectionVersion != SelectionVersion) return;
        if (result.IsSuccess)
        {
            Versions = result.Data ?? [];
        }
        else
        {
            Versions = [];
            Errors = result.Errors;
        }

        IsVersionLoading = false;
    }

    private JsonElement? ParseJson(string? json, string target)
    {
        if (string.IsNullOrWhiteSpace(json))
        {
            return null;
        }

        try
        {
            using var document = JsonDocument.Parse(json);
            return document.RootElement.Clone();
        }
        catch (JsonException exception)
        {
            Errors = [new ApiError("Validation.Json.Invalid", exception.Message, target)];
            return null;
        }
    }

    private Guid? ParseNullableGuid(string? value, string target)
    {
        Errors = [];
        if (string.IsNullOrWhiteSpace(value))
        {
            return null;
        }

        if (Guid.TryParse(value, out var parsed))
        {
            return parsed;
        }

        Errors = [new ApiError("Validation.Guid.Invalid", $"{target} must be a GUID.", target)];
        return null;
    }

    private async void OnProjectStateChanged()
    {
        await InvokeAsync(async () =>
        {
            var projectId = ProjectState.SelectedProject?.ProjectId;
            if (SelectedProjectId == projectId) return;
            SelectedProjectId = projectId;
            ProjectVersion++;
            SelectionVersion++;
            Briefs = [];
            SelectedBrief = null;
            Versions = [];
            AiRegeneration = null;
            GenerateForm = new();
            EditForm = new();
            Errors = [];
            Message = null;
            Query = null;
            ReviewStatusFilter = null;
            IsLoading = IsVersionLoading = IsGenerating = IsAiRegenerating = false;
            await LoadAsync();
            StateHasChanged();
        });
    }

    private static IReadOnlyList<string>? ParseLines(string? value)
    {
        var lines = string.IsNullOrWhiteSpace(value)
            ? []
            : value.Split(['\r', '\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Where(line => !string.IsNullOrWhiteSpace(line))
                .ToArray();
        return lines.Length == 0 ? null : lines;
    }

    private static string FormatJson(JsonElement content)
    {
        if (content.ValueKind is JsonValueKind.Undefined or JsonValueKind.Null)
        {
            return "{}";
        }

        return JsonSerializer.Serialize(content, JsonOptions);
    }

    private static string? Optional(string? value)
        => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private static string FormatDateTime(DateTime value)
        => value.ToLocalTime().ToString("yyyy-MM-dd HH:mm");

    private bool IsCurrentProject(int version, Guid projectId)
        => version == ProjectVersion && ProjectState.SelectedProject?.ProjectId == projectId;

    public void Dispose()
    {
        ProjectVersion++;
        ProjectState.Changed -= OnProjectStateChanged;
    }

    private sealed class GenerateBriefFormModel
    {
        public string? TargetKeyword { get; set; }

        public string? Title { get; set; }

        public string? ClusterId { get; set; }

        public string? CompetitorUrls { get; set; }
    }

    private sealed class BriefEditFormModel
    {
        public string? Title { get; set; }

        public string? ReviewStatus { get; set; } = "pending";

        public string? Status { get; set; } = "draft";

        public string? ContentJson { get; set; } = "{}";

        public string? ChangeSummary { get; set; } = "手動で更新";
    }
}
