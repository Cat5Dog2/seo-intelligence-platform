<section class="page-stack">
    <section class="panel">
        <div class="section-heading">
            <h2>Discord通知設定</h2>
            <div class="toolbar">
                <StatusFilter Value="@ChannelStatus" ValueChanged="@OnChannelStatusChanged" Statuses="@EnabledStatuses" />
                <button type="button" class="secondary-button" @onclick="ReloadAsync">再読み込み</button>
            </div>
        </div>
        <div class="form-grid">
            <label class="field">
                <span>名称</span>
                <input @bind="ChannelForm.Name" />
            </label>
            <label class="field">
                <span>Channel Type</span>
                <input @bind="ChannelForm.ChannelType" />
            </label>
            <label class="field">
                <span>Webhook Secret Ref</span>
                <input @bind="ChannelForm.WebhookSecretRef" />
            </label>
            <label class="field">
                <span>Project Id</span>
                <input @bind="ChannelForm.ProjectId" />
            </label>
            <label class="field">
                <span>Event Types</span>
                <input @bind="ChannelForm.EventTypes" />
            </label>
            <button type="button" class="primary-button" @onclick="SaveChannelAsync">保存</button>
            @if (EditingChannelId.HasValue)
            {
                <button type="button" class="text-button" @onclick="ClearChannelAsync">新規</button>
            }
        </div>

        <DataTable Items="@Channels" Columns="@ChannelColumns" IsLoading="@IsChannelLoading" EmptyText="通知設定はありません。">
            <RowActions Context="channel">
                <div class="row-actions">
                    <button type="button" class="table-action" @onclick="() => EditChannelAsync(channel)">編集</button>
                    <button type="button" class="table-action" @onclick="() => TestChannelAsync(channel.ChannelId)">テスト</button>
                    @if (channel.Status == "disabled")
                    {
                        <button type="button" class="table-action" @onclick="() => EnableChannelAsync(channel.ChannelId)">有効化</button>
                    }
                    else
                    {
                        <button type="button" class="table-action danger-button" @onclick="() => DisableChannelAsync(channel.ChannelId)">無効化</button>
                    }
                    <AuditLink ResourceType="notification_channel" ResourceId="@channel.ChannelId.ToString("D")" />
                </div>
            </RowActions>
        </DataTable>
    </section>

    <section class="panel">
        <div class="section-heading">
            <h2>通知履歴</h2>
            <StatusFilter Value="@DeliveryStatus" ValueChanged="@OnDeliveryStatusChanged" Statuses="@DeliveryStatuses" />
        </div>
        <DataTable Items="@Deliveries" Columns="@DeliveryColumns" IsLoading="@IsDeliveryLoading" EmptyText="通知履歴はありません。">
            <RowActions Context="delivery">
                <div class="row-actions">
                    @if (delivery.Status is "failed" or "retrying")
                    {
                        <button type="button" class="table-action" @onclick="() => RetryDeliveryAsync(delivery.DeliveryId)">再送</button>
                    }
                    <AuditLink ResourceType="notification_delivery" ResourceId="@delivery.DeliveryId.ToString("D")" />
                </div>
            </RowActions>
        </DataTable>
    </section>
</section>

@code {
    [Parameter]
    public string ChannelStatus { get; set; } = "active";

    [Parameter]
    public string DeliveryStatus { get; set; } = "all";

    [Parameter]
    public IReadOnlyList<StatusFilterOption> EnabledStatuses { get; set; } = [];

    [Parameter]
    public IReadOnlyList<StatusFilterOption> DeliveryStatuses { get; set; } = [];

    [Parameter]
    public AdminChannelFormModel ChannelForm { get; set; } = new();

    [Parameter]
    public Guid? EditingChannelId { get; set; }

    [Parameter]
    public IReadOnlyList<NotificationChannelDetails> Channels { get; set; } = [];

    [Parameter]
    public IReadOnlyList<NotificationDeliveryDetails> Deliveries { get; set; } = [];

    [Parameter]
    public IReadOnlyList<DataTableColumn<NotificationChannelDetails>> ChannelColumns { get; set; } = [];

    [Parameter]
    public IReadOnlyList<DataTableColumn<NotificationDeliveryDetails>> DeliveryColumns { get; set; } = [];

    [Parameter]
    public bool IsChannelLoading { get; set; }

    [Parameter]
    public bool IsDeliveryLoading { get; set; }

    [Parameter]
    public EventCallback<string> OnChannelStatusChanged { get; set; }

    [Parameter]
    public EventCallback<string> OnDeliveryStatusChanged { get; set; }

    [Parameter]
    public EventCallback OnReload { get; set; }

    [Parameter]
    public EventCallback OnSaveChannel { get; set; }

    [Parameter]
    public EventCallback OnClearChannel { get; set; }

    [Parameter]
    public EventCallback<NotificationChannelDetails> OnEditChannel { get; set; }

    [Parameter]
    public EventCallback<Guid> OnTestChannel { get; set; }

    [Parameter]
    public EventCallback<Guid> OnEnableChannel { get; set; }

    [Parameter]
    public EventCallback<Guid> OnDisableChannel { get; set; }

    [Parameter]
    public EventCallback<Guid> OnRetryDelivery { get; set; }

    private Task ReloadAsync()
        => OnReload.InvokeAsync();

    private Task SaveChannelAsync()
        => OnSaveChannel.InvokeAsync();

    private Task ClearChannelAsync()
        => OnClearChannel.InvokeAsync();

    private Task EditChannelAsync(NotificationChannelDetails channel)
        => OnEditChannel.InvokeAsync(channel);

    private Task TestChannelAsync(Guid channelId)
        => OnTestChannel.InvokeAsync(channelId);

    private Task EnableChannelAsync(Guid channelId)
        => OnEnableChannel.InvokeAsync(channelId);

    private Task DisableChannelAsync(Guid channelId)
        => OnDisableChannel.InvokeAsync(channelId);

    private Task RetryDeliveryAsync(Guid deliveryId)
        => OnRetryDelivery.InvokeAsync(deliveryId);
}
