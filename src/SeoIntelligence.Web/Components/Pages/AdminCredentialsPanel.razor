<section class="panel">
    <div class="section-heading">
        <h2>API認証情報</h2>
        <div class="toolbar">
            <StatusFilter Value="@CredentialStatus" ValueChanged="@OnStatusChanged" Statuses="@EnabledStatuses" />
            <button type="button" class="secondary-button" @onclick="ReloadAsync">再読み込み</button>
        </div>
    </div>

    <div class="form-columns">
      <div class="form-fields">
        <label class="field">
            <span>サービス</span>
            <input data-testid="admin-credential-provider-input" @bind="CredentialForm.Provider" />
        </label>
        @if (!EditingCredentialId.HasValue)
        {
        <label class="field">
            <span>APIキー</span>
            <input type="password" data-testid="admin-credential-secret-input" @bind="CredentialForm.SecretValue" autocomplete="off" />
            <small class="field-help">登録後は再表示されません。</small>
        </label>
        <details class="advanced-settings full-width">
            <summary>詳細設定</summary>
            <p class="field-help">登録済みのキー参照名を使う場合のみ指定します。APIキーを直接入力する場合は空欄で構いません。</p>
            <label class="field"><span>キー参照名</span><input data-testid="admin-credential-key-ref-input" @bind="CredentialForm.KeyRef" /></label>
        </details>
        }
        else
        {
            <p class="field-help">APIキーを変更するには、一覧の「キーを更新」を使ってください。</p>
        }
        <div class="form-actions full-width">
        <button type="button" class="primary-button" data-testid="admin-credential-save-button" @onclick="SaveAsync">@(EditingCredentialId.HasValue ? "サービス情報を更新" : "APIキーを登録")</button>
        @if (EditingCredentialId.HasValue)
        {
            <button type="button" class="text-button" @onclick="ClearAsync">編集をやめる</button>
        }
        </div>
      </div>
    </div>

    @if (RotatingCredentialId.HasValue)
    {
        <div class="form-grid">
            <label class="field">
                <span>新しいキー参照名（登録済みのキーを使う場合）</span>
                <input @bind="RotateForm.NewKeyRef" />
            </label>
            <label class="field">
                <span>新しいAPIキー</span>
                <input type="password" @bind="RotateForm.NewSecretValue" autocomplete="off" />
            </label>
            <button type="button" class="secondary-button" @onclick="RotateAsync">キーを更新</button>
            <button type="button" class="text-button" @onclick="ClearRotateAsync">閉じる</button>
        </div>
    }

    <DataTable Items="@Credentials" Columns="@CredentialColumns" IsLoading="@IsCredentialLoading" EmptyText="API認証情報はありません。">
        <RowActions Context="credential">
            <div class="row-actions">
                <button type="button" class="table-action" @onclick="() => EditAsync(credential)">編集</button>
                <button type="button" class="table-action" @onclick="() => StartRotateAsync(credential.CredentialId)">キーを更新</button>
                @if (credential.Status == "disabled")
                {
                    <button type="button" class="table-action" @onclick="() => EnableAsync(credential.CredentialId)">有効化</button>
                }
                else
                {
                    <button type="button" class="table-action danger-button" @onclick="() => DisableAsync(credential.CredentialId)">無効化</button>
                }
                <AuditLink ResourceType="api_credential" ResourceId="@credential.CredentialId.ToString("D")" />
            </div>
        </RowActions>
    </DataTable>
</section>

@code {
    [Parameter]
    public string CredentialStatus { get; set; } = "active";

    [Parameter]
    public IReadOnlyList<StatusFilterOption> EnabledStatuses { get; set; } = [];

    [Parameter]
    public AdminCredentialFormModel CredentialForm { get; set; } = new();

    [Parameter]
    public AdminRotateCredentialFormModel RotateForm { get; set; } = new();

    [Parameter]
    public Guid? EditingCredentialId { get; set; }

    [Parameter]
    public Guid? RotatingCredentialId { get; set; }

    [Parameter]
    public IReadOnlyList<ApiCredentialDetails> Credentials { get; set; } = [];

    [Parameter]
    public IReadOnlyList<DataTableColumn<ApiCredentialDetails>> CredentialColumns { get; set; } = [];

    [Parameter]
    public bool IsCredentialLoading { get; set; }

    [Parameter]
    public EventCallback<string> OnStatusChanged { get; set; }

    [Parameter]
    public EventCallback OnReload { get; set; }

    [Parameter]
    public EventCallback OnSave { get; set; }

    [Parameter]
    public EventCallback OnClear { get; set; }

    [Parameter]
    public EventCallback OnRotate { get; set; }

    [Parameter]
    public EventCallback OnClearRotate { get; set; }

    [Parameter]
    public EventCallback<ApiCredentialDetails> OnEdit { get; set; }

    [Parameter]
    public EventCallback<Guid> OnStartRotate { get; set; }

    [Parameter]
    public EventCallback<Guid> OnEnable { get; set; }

    [Parameter]
    public EventCallback<Guid> OnDisable { get; set; }

    private Task ReloadAsync()
        => OnReload.InvokeAsync();

    private Task SaveAsync()
        => OnSave.InvokeAsync();

    private Task ClearAsync()
        => OnClear.InvokeAsync();

    private Task RotateAsync()
        => OnRotate.InvokeAsync();

    private Task ClearRotateAsync()
        => OnClearRotate.InvokeAsync();

    private Task EditAsync(ApiCredentialDetails credential)
        => OnEdit.InvokeAsync(credential);

    private Task StartRotateAsync(Guid credentialId)
        => OnStartRotate.InvokeAsync(credentialId);

    private Task EnableAsync(Guid credentialId)
        => OnEnable.InvokeAsync(credentialId);

    private Task DisableAsync(Guid credentialId)
        => OnDisable.InvokeAsync(credentialId);
}
