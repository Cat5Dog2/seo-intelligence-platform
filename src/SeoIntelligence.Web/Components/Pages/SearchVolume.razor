@page "/search-volume"
@attribute [Authorize(Policy = ApplicationPolicies.RequireWorkspaceAccess)]
@using System.Text.Json
@implements IDisposable
@inject ISeoIntelligenceApiClient ApiClient
@inject ProjectSelectionState ProjectState
@inject IJSRuntime JS

<PageTitle>検索ボリューム - SEO Intelligence</PageTitle>

<div class="page-stack">
    <header class="page-header">
        <div>
            <h1>検索ボリューム</h1>
            <p class="project-context">選択中プロジェクト: @(ProjectState.SelectedProject?.Name ?? "未選択")</p>
        </div>
    </header>

    <ErrorSummary Errors="@Errors" />
    @if (!ProjectState.IsLoading && ProjectState.SelectedProject is null && ProjectState.ErrorMessage is null)
    {
        <GettingStarted />
    }
    @if (!string.IsNullOrWhiteSpace(Message))
    {
        <div class="state-row completion-notice" role="status" data-testid="search-volume-status-message">
            <span>@Message</span>
            @if (ResearchCompleted)
            {
                <a class="primary-button" href="/search-volume#search-volume-results" @onclick="ShowResultsAsync" @onclick:preventDefault>結果を見る</a>
            }
        </div>
    }

    <details class="panel research-flow" data-testid="research-input" open="@(!ResearchCompleted)">
        <summary>入力・調査条件@(ResearchCompleted ? "（完了）" : "")</summary>
        <div class="page-stack">
        <div>
            <p class="muted input-count">@InputSummary</p>
            <div class="form-grid dense-form">
                <label class="field wide-field">
                    <span>キーワード貼付</span>
                    <textarea data-testid="search-volume-keywords-input" @bind="KeywordsText" @bind:event="oninput" disabled="@(ProjectState.SelectedProject is null)"></textarea>
                </label>
            </div>
            <details class="advanced-options">
                <summary>CSV・調査条件（@UiText.Location(SearchVolumeForm.Location)・@UiText.Language(SearchVolumeForm.Language)）</summary>
                <div class="form-grid dense-form">
                <label class="field">
                    <span>CSVファイル</span>
                    <input id="@CsvInputId" type="file" accept=".csv,text/csv,text/plain" @onchange="ReadCsvFileAsync" disabled="@(ProjectState.SelectedProject is null)" />
                </label>
                <LocaleFields @bind-Location="SearchVolumeForm.Location" @bind-Language="SearchVolumeForm.Language" Disabled="@(ProjectState.SelectedProject is null)" LocationTestId="search-volume-location-input" LanguageTestId="search-volume-language-input" />
                <label class="field">
                    <span>集計月数</span>
                    <input type="number" min="1" max="24" @bind="SearchVolumeForm.AggregationPeriodMonths" disabled="@(ProjectState.SelectedProject is null)" />
                </label>
                <label class="check-option compact-check">
                    <input type="checkbox" @bind="SearchVolumeForm.SeoDifficulty" disabled="@(ProjectState.SelectedProject is null)" />
                    <span>SEO難易度を取得</span>
                </label>
                </div>
            </details>
            <div class="button-row">
                <button type="button" class="primary-button" data-testid="search-volume-register-button" @onclick="RegisterJobAsync" disabled="@(!CanRegister)">検索ボリュームを調べる</button>
                <button type="button" class="text-button" @onclick="ClearInput">入力クリア</button>
            </div>
        </div>

        @if (CurrentJob is not null || IsJobLoading)
        {
            <section class="panel" aria-label="調査の進捗" aria-busy="@IsJobLoading.ToString().ToLowerInvariant()">
                <div class="section-heading">
                    <h2>調査の進捗</h2>
                    <div class="toolbar">
                        @if (CanCancel) { <button type="button" class="secondary-button" @onclick="CancelJobAsync">キャンセル</button> }
                        @if (CanRetry) { <button type="button" class="secondary-button" @onclick="RetryJobAsync">再試行</button> }
                        <button type="button" class="text-button" @onclick="RefreshJobAsync" disabled="@IsJobLoading">状態を再確認</button>
                    </div>
                </div>
                @if (CurrentJob is { } job)
                {
                    <div class="job-status-card" role="status">
                        <strong>@UiText.Status(job.Status)</strong>
                        <progress aria-label="調査の進捗" max="100" value="@job.Progress"></progress>
                        <span>@job.Progress%</span>
                    </div>
                    @if (IsJobPending) { <p class="muted">完了すると結果を自動で表示します。</p> }
                    @if (job.Status.StartsWith("failed", StringComparison.Ordinal))
                    {
                        <p class="muted">調査を完了できませんでした。@(CanRetry ? "再試行するか、条件を変更して調査できます。" : "条件を確認して、もう一度調査してください。")</p>
                    }
                }
            </section>
        }
        </div>
    </details>
        <details class="advanced-options research-history">
            <summary>過去の調査を開く</summary>
            <div class="form-grid">
                <label class="field wide-field"><span>ジョブID</span><input data-testid="search-volume-job-id-input" @bind="JobIdText" /></label>
                <button type="button" class="secondary-button" @onclick="RefreshJobAsync" disabled="@(!HasCurrentJob || IsJobLoading)">読み込み</button>
            </div>
        </details>

    <section class="panel" aria-labelledby="search-volume-results">
        <div class="section-heading compact-heading">
            <h2 id="search-volume-results" tabindex="-1">結果 <span class="muted">@Results.Count 件</span></h2>
            <button type="button" class="secondary-button" data-testid="search-volume-export-button" @onclick="CreateResultsExportAsync" disabled="@(Results.Count == 0 || IsExporting)">CSV出力</button>
        </div>
        @if (HasCurrentJob)
        {
        <details class="result-filters">
            <summary>絞り込み・並べ替え@(string.IsNullOrWhiteSpace(ResultQuery) ? "" : $" · {ResultQuery}")</summary>
            <div class="toolbar">
                <label class="field-inline">
                    <span>検索</span>
                    <input @bind="ResultQuery" @bind:event="oninput" disabled="@(!HasCurrentJob)" />
                </label>
                <label class="field-inline">
                    <span>並べ替え項目</span>
                    <select @bind="ResultSortBy" disabled="@(!HasCurrentJob)">
                        <option value="keyword">キーワード</option>
                        <option value="searchVolume">検索ボリューム</option>
                        <option value="seoDifficulty">SEO難易度</option>
                        <option value="cpc">CPC</option>
                        <option value="competition">広告競合性</option>
                    </select>
                </label>
                <label class="field-inline">
                    <span>並び順</span>
                    <select @bind="ResultOrderBy" disabled="@(!HasCurrentJob)">
                        <option value="asc">昇順</option>
                        <option value="desc">降順</option>
                    </select>
                </label>
                <button type="button" class="secondary-button" @onclick="LoadResultsAsync" disabled="@(!HasCurrentJob)">検索</button>
            </div>
        </details>
        }
        <DataTable Items="@Results" Columns="@ResultColumns" MobileCards="true" IsLoading="@IsResultLoading" EmptyText="検索ボリューム結果はありません。" />
    </section>
    @if (ProjectState.SelectedProject is not null)
    {
        <section class="panel">
            <JobProgressPanel @ref="ExportPanel" Title="CSV出力" ProjectScoped="true" JobType="DataExportJob" />
        </section>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "jobId")]
    public string? InitialJobId { get; set; }

    private string? LoadedQueryJobId;

    protected override async Task OnParametersSetAsync()
    {
        if (string.IsNullOrWhiteSpace(InitialJobId) || InitialJobId == LoadedQueryJobId) return;
        LoadedQueryJobId = InitialJobId;
        JobIdText = InitialJobId;
        await RefreshJobAsync();
    }

    private const string CsvInputId = "search-volume-csv-file";
    private static readonly JsonSerializerOptions JsonOptions = new(JsonSerializerDefaults.Web);

    private static readonly IReadOnlyList<DataTableColumn<SearchVolumeResultRow>> ResultColumns =
    [
        new("キーワード", row => row.Keyword),
        new("検索ボリューム", row => row.SearchVolume?.ToString() ?? "-", "table-number"),
        new("SEO難易度", row => FormatNullable(row.SeoDifficulty), "table-number"),
        new("CPC", row => FormatNullable(row.Cpc), "table-number"),
        new("広告競合性", row => FormatNullable(row.Competition), "table-number"),
        new("取得元", row => row.DataSource),
        new("キャッシュ", row => row.CacheHit ? "再利用" : "新規取得"),
        new("月別推移", row => FormatMonthly(row.MonthlySearchVolume))
    ];

    private SearchVolumeFormModel SearchVolumeForm { get; set; } = new();

    private string? KeywordsText { get; set; }

    private string? JobIdText { get; set; }

    private JobDetails? CurrentJob { get; set; }

    private IReadOnlyList<SearchVolumeResultRow> Results { get; set; } = [];

    private IReadOnlyList<ApiError> Errors { get; set; } = [];

    private string? Message { get; set; }

    private bool ResearchCompleted { get; set; }

    private async Task ShowResultsAsync() => await JS.InvokeVoidAsync("seoIntelligence.focusSection", "search-volume-results");

    private bool IsRegistering { get; set; }

    private bool IsJobLoading { get; set; }

    private bool IsResultLoading { get; set; }

    private bool IsExporting { get; set; }

    private string? ResultQuery { get; set; }

    private string ResultSortBy { get; set; } = "keyword";

    private string ResultOrderBy { get; set; } = "asc";

    private Guid? SelectedProjectId { get; set; }

    private int ProjectVersion { get; set; }

    private int JobLoadVersion { get; set; }

    private int ResultLoadVersion { get; set; }

    private KeywordInputParseResult ParsedInput => KeywordInputParser.Parse(KeywordsText);

    private string InputSummary
        => $"{ParsedInput.Keywords.Count:N0}件 / 空欄 {ParsedInput.BlankCount:N0} / 重複 {ParsedInput.DuplicateCount:N0}";

    private bool CanRegister
        => ProjectState.SelectedProject is not null && !IsRegistering && !IsJobPending;

    private JobProgressPanel? ExportPanel;
    private CancellationTokenSource? PollingCancellation;
    private Task PollingTask { get; set; } = Task.CompletedTask;
    private bool IsJobPending => CurrentJob?.Status is "queued" or "running" or "waiting_external";

    private bool HasCurrentJob
        => Guid.TryParse(JobIdText, out _);

    private bool CanCancel
        => CurrentJob is not null &&
            (string.Equals(CurrentJob.Status, "queued", StringComparison.OrdinalIgnoreCase) ||
             string.Equals(CurrentJob.Status, "waiting_external", StringComparison.OrdinalIgnoreCase));

    private bool CanRetry
        => CurrentJob is not null &&
            string.Equals(CurrentJob.Status, "failed_retryable", StringComparison.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        ProjectState.Changed += OnProjectStateChanged;
        await ProjectState.LoadAsync();
        SyncDefaultsFromProject();
    }

    private async Task ReadCsvFileAsync()
    {
        var projectVersion = ProjectVersion;
        Errors = [];
        Message = null;
        try
        {
            var text = await JS.InvokeAsync<string>("seoIntelligence.readTextFile", CsvInputId);
            if (projectVersion == ProjectVersion) KeywordsText = text;
        }
        catch (JSException exception)
        {
            if (projectVersion == ProjectVersion) Errors = [new ApiError("Csv.ReadFailed", exception.Message, "csv")];
        }
    }

    private async Task RegisterJobAsync()
    {
        if (!CanRegister || ProjectState.SelectedProject is not { } project || !ValidateInput())
        {
            return;
        }

        StopPolling();
        ResearchCompleted = false;
        CurrentJob = null;
        Results = [];
        JobIdText = null;
        ++ResultLoadVersion;
        IsRegistering = true;
        var projectVersion = ProjectVersion;
        Errors = [];
        Message = null;
        var keywords = ParsedInput.Keywords;
        var result = await ApiClient.RegisterSearchVolumeJobAsync(
            project.ProjectId,
            new SearchVolumeJobRequest(
                keywords,
                SearchVolumeForm.Location!.Trim(),
                SearchVolumeForm.Language!.Trim(),
                SearchVolumeForm.AggregationPeriodMonths,
                SearchVolumeForm.SeoDifficulty));
        if (projectVersion != ProjectVersion) return;
        if (result.IsSuccess && result.Data is { } job)
        {
            JobIdText = job.JobId.ToString("D");
            Message = "調査を開始しました。";
            await LoadJobAsync(job.JobId);
            if (projectVersion == ProjectVersion) StartPolling();
        }
        else
        {
            Errors = result.Errors;
        }

        if (projectVersion == ProjectVersion) IsRegistering = false;
    }

    private async Task RefreshJobAsync()
    {
        if (TryGetCurrentJobId(out var jobId))
        {
            StopPolling();
            await LoadJobAsync(jobId);
            StartPolling();
        }
    }

    private async Task LoadJobAsync(Guid jobId)
    {
        if (ProjectState.SelectedProject is not { } project) return;
        var projectVersion = ProjectVersion;
        var loadVersion = ++JobLoadVersion;
        IsJobLoading = true;
        Errors = [];
        if (CurrentJob?.JobId != jobId)
        {
            Results = [];
            ResearchCompleted = false;
            Message = null;
        }
        IsResultLoading = false;
        ++ResultLoadVersion;
        var result = await ApiClient.GetJobAsync(jobId);
        if (projectVersion != ProjectVersion || loadVersion != JobLoadVersion) return;
        if (result.IsSuccess && result.Data is { } job && job.ProjectId == project.ProjectId &&
            job.JobType == "RegisterSearchVolumeJob")
        {
            CurrentJob = job;
            JobIdText = jobId.ToString("D");
            if (job.Status == "succeeded")
            {
                await LoadResultsAsync();
                if (projectVersion != ProjectVersion || loadVersion != JobLoadVersion) return;
                Message = Errors.Count == 0 ? "調査が完了しました。結果を確認できます。" : null;
                ResearchCompleted = Errors.Count == 0;
            }
        }
        else
        {
            CurrentJob = null;
            ResearchCompleted = false;
            Results = [];
            JobIdText = null;
            Errors = result.IsSuccess
                ? [new ApiError("Resource.NotFound", "このプロジェクトの検索ボリュームジョブが見つかりません。", "jobId")]
                : result.Errors;
        }

        IsJobLoading = false;
    }

    private async Task LoadResultsAsync()
    {
        if (ProjectState.SelectedProject is not { } project || !TryGetCurrentJobId(out var jobId))
        {
            return;
        }

        IsResultLoading = true;
        var projectVersion = ProjectVersion;
        var loadVersion = ++ResultLoadVersion;
        Errors = [];
        var result = await ApiClient.GetSearchVolumeResultsAsync(
            project.ProjectId,
            jobId,
            ResultQuery,
            ResultSortBy,
            ResultOrderBy,
            pageSize: 100);
        if (projectVersion != ProjectVersion || loadVersion != ResultLoadVersion) return;
        IsResultLoading = false;
        if (JobIdText != jobId.ToString("D")) return;
        if (result.IsSuccess)
        {
            Results = result.Data ?? [];
        }
        else
        {
            Results = [];
            Errors = result.Errors;
        }

        IsResultLoading = false;
    }

    private async Task CancelJobAsync()
    {
        if (!CanCancel || CurrentJob is null || CurrentJob.ProjectId != ProjectState.SelectedProject?.ProjectId ||
            !TryGetCurrentJobId(out var jobId) || CurrentJob.JobId != jobId)
        {
            return;
        }

        var projectVersion = ProjectVersion;
        StopPolling();
        ++JobLoadVersion;
        IsJobLoading = false;
        var result = await ApiClient.CancelJobAsync(jobId);
        if (projectVersion != ProjectVersion || JobIdText != jobId.ToString("D")) return;
        if (result.IsSuccess)
        {
            CurrentJob = result.Data;
            StartPolling();
        }
        else
        {
            Errors = result.Errors;
        }
    }

    private async Task RetryJobAsync()
    {
        if (!CanRetry || CurrentJob is null || CurrentJob.ProjectId != ProjectState.SelectedProject?.ProjectId ||
            !TryGetCurrentJobId(out var jobId) || CurrentJob.JobId != jobId)
        {
            return;
        }

        var projectVersion = ProjectVersion;
        StopPolling();
        ++JobLoadVersion;
        IsJobLoading = false;
        var result = await ApiClient.RetryJobAsync(jobId);
        if (projectVersion != ProjectVersion || JobIdText != jobId.ToString("D")) return;
        if (result.IsSuccess)
        {
            CurrentJob = result.Data;
            StartPolling();
        }
        else
        {
            Errors = result.Errors;
        }
    }

    private async Task CreateResultsExportAsync()
    {
        if (ProjectState.SelectedProject is not { } project || !TryGetCurrentJobId(out var jobId))
        {
            return;
        }

        IsExporting = true;
        var projectVersion = ProjectVersion;
        Errors = [];
        Message = null;
        var filter = JsonSerializer.SerializeToElement(
            new
            {
                jobId = jobId.ToString("D"),
                q = ResultQuery
            },
            JsonOptions);
        var result = await ApiClient.CreateCsvExportAsync(
            project.ProjectId,
            new DataExportRequest("search_volume_results", filter));
        if (projectVersion != ProjectVersion) return;
        IsExporting = false;
        if (JobIdText != jobId.ToString("D")) return;
        if (result.IsSuccess && result.Data is { } exportJob)
        {
            Message = "CSV出力を受け付けました。完了後に下のCSV出力欄からダウンロードできます。";
            if (ExportPanel is not null) await ExportPanel.RefreshAsync();
        }
        else
        {
            Errors = result.Errors;
        }

        IsExporting = false;
    }

    private bool ValidateInput()
    {
        var errors = new List<ApiError>();
        if (ProjectState.SelectedProject is null)
        {
            errors.Add(new ApiError("Validation.Project.Required", "プロジェクトを選択してください。", "projectId"));
        }

        var parsed = ParsedInput;
        if (parsed.Keywords.Count == 0)
        {
            errors.Add(new ApiError("Validation.Keywords.Required", "キーワードを1件以上入力してください。", "keywords"));
        }
        else if (parsed.Keywords.Count > KeywordInputParser.MaxKeywordCount)
        {
            errors.Add(new ApiError("Validation.Keywords.Max", "キーワードは重複除外後50,000件までです。", "keywords"));
        }

        if (string.IsNullOrWhiteSpace(SearchVolumeForm.Location))
        {
            errors.Add(new ApiError("Validation.Location.Required", "地域を入力してください。", "location"));
        }

        if (string.IsNullOrWhiteSpace(SearchVolumeForm.Language))
        {
            errors.Add(new ApiError("Validation.Language.Required", "言語を入力してください。", "language"));
        }

        if (SearchVolumeForm.AggregationPeriodMonths is < 1 or > 24)
        {
            errors.Add(new ApiError("Validation.AggregationPeriod.Range", "集計月数は1から24で指定してください。", "aggregationPeriodMonths"));
        }

        Errors = errors;
        return errors.Count == 0;
    }

    private bool TryGetCurrentJobId(out Guid jobId)
    {
        if (Guid.TryParse(JobIdText, out jobId))
        {
            return true;
        }

        Errors = [new ApiError("Validation.JobId.Invalid", "調査のジョブIDを正しい形式で入力してください。", "jobId")];
        return false;
    }

    private void ClearInput()
    {
        ResearchCompleted = false;
        StopPolling();
        ++ProjectVersion;
        ++JobLoadVersion;
        ++ResultLoadVersion;
        CurrentJob = null;
        JobIdText = null;
        IsRegistering = IsJobLoading = IsResultLoading = IsExporting = false;
        KeywordsText = null;
        Results = [];
        Message = null;
        Errors = [];
    }

    private void OnProjectStateChanged()
    {
        SyncDefaultsFromProject();
        _ = InvokeAsync(StateHasChanged);
    }

    private void SyncDefaultsFromProject()
    {
        var projectId = ProjectState.SelectedProject?.ProjectId;
        if (SelectedProjectId != projectId)
        {
            ResearchCompleted = false;
            StopPolling();
            SelectedProjectId = projectId;
            ++ProjectVersion;
            ++JobLoadVersion;
            ++ResultLoadVersion;
            KeywordsText = null;
            JobIdText = null;
            CurrentJob = null;
            Results = [];
            Errors = [];
            Message = null;
            ResultQuery = null;
            ResultSortBy = "keyword";
            ResultOrderBy = "asc";
            IsRegistering = IsJobLoading = IsResultLoading = IsExporting = false;
        }
        if (ProjectState.SelectedProject is not { } project)
        {
            return;
        }

        SearchVolumeForm.Location = project.DefaultLocation;
        SearchVolumeForm.Language = project.DefaultLanguage;
    }

    private void StartPolling()
    {
        StopPolling();
        if (!IsJobPending || !Guid.TryParse(JobIdText, out var jobId)) return;
        PollingCancellation = new CancellationTokenSource();
        PollingTask = PollJobAsync(jobId, ProjectVersion, PollingCancellation.Token);
    }

    private async Task PollJobAsync(Guid jobId, int projectVersion, CancellationToken cancellationToken)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(2));
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                await InvokeAsync(async () =>
                {
                    if (cancellationToken.IsCancellationRequested || projectVersion != ProjectVersion) return;
                    await LoadJobAsync(jobId);
                    if (!cancellationToken.IsCancellationRequested && projectVersion == ProjectVersion) StateHasChanged();
                });
                if (cancellationToken.IsCancellationRequested || projectVersion != ProjectVersion || !IsJobPending || Errors.Count > 0) break;
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
        catch (Exception exception)
        {
            await DispatchExceptionAsync(exception);
        }
    }

    private void StopPolling()
    {
        PollingCancellation?.Cancel();
        PollingCancellation?.Dispose();
        PollingCancellation = null;
    }

    private static string FormatNullable(decimal? value)
        => value.HasValue ? value.Value.ToString("0.####") : "-";

    private static string FormatMonthly(IReadOnlyDictionary<string, int>? values)
        => values is null || values.Count == 0
            ? "-"
            : string.Join(", ", values.OrderByDescending(pair => pair.Key).Take(6).Select(pair => $"{pair.Key}:{pair.Value}"));

    private static string FormatDateTime(DateTime value)
        => value.ToLocalTime().ToString("yyyy-MM-dd HH:mm");

    public void Dispose()
    {
        StopPolling();
        ProjectState.Changed -= OnProjectStateChanged;
        ++ProjectVersion;
    }

    private sealed class SearchVolumeFormModel
    {
        public string? Location { get; set; } = "Japan";

        public string? Language { get; set; } = "Japanese";

        public int AggregationPeriodMonths { get; set; } = 12;

        public bool SeoDifficulty { get; set; } = true;
    }
}
