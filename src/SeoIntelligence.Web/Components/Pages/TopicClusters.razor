@page "/clusters"
@attribute [Authorize(Policy = ApplicationPolicies.RequireWorkspaceAccess)]
@inherits WorkspaceComponentBase
@implements IDisposable
@inject ISeoIntelligenceApiClient ApiClient
@inject ProjectSelectionState ProjectState
@inject NavigationManager Navigation

<PageTitle>トピッククラスター - SEO Intelligence</PageTitle>

<div class="page-stack">
    <header class="page-header">
        <div>
            <h1>トピッククラスター</h1>
            <p class="project-context">選択中プロジェクト: @(ProjectState.SelectedProject?.Name ?? "未選択")</p>
        </div>
        <div class="toolbar">
            <button type="button" class="secondary-button" @onclick="LoadAsync" disabled="@(ProjectState.SelectedProject is null)">更新</button>
        </div>
    </header>

    @if (IsGuest)
    {
        <GuestReadOnlyNotice />
    }
    <ErrorSummary Errors="@Errors" />
    @if (!ProjectState.IsLoading && ProjectState.SelectedProject is null && ProjectState.ErrorMessage is null)
    {
        <GettingStarted />
    }
    @if (!string.IsNullOrWhiteSpace(Message))
    {
        <div class="state-row">@Message</div>
    }

    <section class="panel">
        <div class="section-heading">
            <h2>検索条件</h2>
            <span class="muted">@(Clusters.Count)件表示</span>
        </div>
        <div class="form-grid dense-form">
            <label class="field wide-field">
                <span>検索</span>
                <input @bind="Query" @bind:event="oninput" disabled="@(ProjectState.SelectedProject is null)" />
            </label>
            <label class="field">
                <span>検索意図</span>
                <select @bind="IntentLabel" disabled="@(ProjectState.SelectedProject is null)">
                    <option value="">すべて</option>
                    <option value="informational">情報を知りたい</option>
                    <option value="commercial">比較・検討したい</option>
                    <option value="transactional">購入・申込みをしたい</option>
                    <option value="navigational">特定のサイトを探したい</option>
                </select>
            </label>
            <label class="field">
                <span>並べ替え項目</span>
                <select @bind="SortBy" disabled="@(ProjectState.SelectedProject is null)">
                    <option value="score">スコア</option>
                    <option value="name">名称</option>
                    <option value="representativeKeyword">代表キーワード</option>
                    <option value="keywordCount">キーワード数</option>
                    <option value="childCount">子クラスター数</option>
                    <option value="updatedAt">更新日時</option>
                </select>
            </label>
            <label class="field">
                <span>並び順</span>
                <select @bind="OrderBy" disabled="@(ProjectState.SelectedProject is null)">
                    <option value="desc">降順</option>
                    <option value="asc">昇順</option>
                </select>
            </label>
            @if (!IsGuest)
            {
            <label class="check-option compact-check">
                <input type="checkbox" @bind="Regenerate" disabled="@(ProjectState.SelectedProject is null)" />
                <span>再生成</span>
            </label>
                <button type="button" class="primary-button" @onclick="GenerateAsync" disabled="@(!CanOperate)">クラスターを生成</button>
            }
            <button type="button" class="secondary-button" @onclick="LoadAsync" disabled="@(ProjectState.SelectedProject is null)">検索</button>
        </div>
    </section>

    <section class="split-grid">
        <div class="panel">
            <div class="section-heading">
                <h2>クラスタ一覧</h2>
            </div>
            <DataTable Items="@Clusters" Columns="@ClusterColumns" IsLoading="@IsLoading" EmptyText="トピッククラスターはありません。">
                <RowActions Context="cluster">
                    <div class="row-actions">
                        <button type="button" class="table-action" @onclick="() => SelectClusterAsync(cluster.ClusterId)">詳細</button>
                        @if (!IsGuest)
                        {
                            <button type="button" class="table-action" @onclick="() => GenerateBriefAsync(cluster)">ブリーフ作成</button>
                        }
                    </div>
                </RowActions>
            </DataTable>
        </div>

        <div class="panel">
            <div class="section-heading">
                <h2>詳細</h2>
                @if (SelectedCluster is not null)
                {
                    <button type="button" class="secondary-button" @onclick="NavigateToBriefs">記事ブリーフ</button>
                }
            </div>
            @if (SelectedCluster is null)
            {
                <div class="state-row">クラスタを選択してください。</div>
            }
            else
            {
                <div class="detail-list">
                    <div><span>代表語</span><strong>@(SelectedCluster.RepresentativeKeyword ?? "-")</strong></div>
                    <div><span>親クラスタ</span><strong>@(SelectedCluster.ParentName ?? "-")</strong></div>
                    <div><span>検索意図</span><strong>@(SelectedCluster.IntentLabel ?? "-")</strong></div>
                    <div><span>機会スコア</span><strong>@SelectedCluster.Score.ToString("0.####")</strong></div>
                </div>

                <h3 class="subsection-title">所属キーワード</h3>
                <DataTable Items="@SelectedCluster.Keywords" Columns="@KeywordColumns" EmptyText="キーワードはありません。" />

                <h3 class="subsection-title">記事候補</h3>
                <DataTable Items="@SelectedCluster.ArticleCandidates" Columns="@ArticleCandidateColumns" EmptyText="記事候補はありません。" />

                <h3 class="subsection-title">内部リンク候補</h3>
                <DataTable Items="@SelectedCluster.InternalLinkCandidates" Columns="@InternalLinkColumns" EmptyText="内部リンク候補はありません。" />
            }
        </div>
    </section>
</div>

@code {
    private static readonly IReadOnlyList<DataTableColumn<TopicClusterSummary>> ClusterColumns =
    [
        new("クラスタ名", cluster => cluster.Name),
        new("代表語", cluster => cluster.RepresentativeKeyword),
        new("親", cluster => cluster.ParentName),
        new("キーワード", cluster => cluster.KeywordCount.ToString(), "table-number"),
        new("スコア", cluster => cluster.Score.ToString("0.####"), "table-number"),
        new("検索意図", cluster => cluster.IntentLabel),
        new("子", cluster => cluster.ChildCount.ToString(), "table-number")
    ];

    private static readonly IReadOnlyList<DataTableColumn<TopicClusterKeywordRow>> KeywordColumns =
    [
        new("キーワード", row => row.Keyword),
        new("役割", row => row.Role),
        new("スコア", row => row.OpportunityScore.ToString("0.####"), "table-number"),
        new("検索意図", row => UiText.SearchIntent(row.IntentLabel)),
        new("FAQ", row => row.Evidence.FaqCount.ToString(), "table-number"),
        new("取得元", row => string.Join(", ", row.Evidence.Sources))
    ];

    private static readonly IReadOnlyList<DataTableColumn<ArticleCandidateSummary>> ArticleCandidateColumns =
    [
        new("タイトル", row => row.Title),
        new("キーワード", row => row.TargetKeyword),
        new("検索意図", row => UiText.SearchIntent(row.IntentLabel)),
        new("スコア", row => row.OpportunityScore.ToString("0.####"), "table-number"),
        new("状態", row => UiText.Status(row.Status))
    ];

    private static readonly IReadOnlyList<DataTableColumn<InternalLinkCandidate>> InternalLinkColumns =
    [
        new("リンク元", row => row.SourceClusterName),
        new("リンク先", row => row.TargetClusterName),
        new("理由", row => row.Reason)
    ];

    private IReadOnlyList<TopicClusterSummary> Clusters { get; set; } = [];

    private TopicClusterDetails? SelectedCluster { get; set; }

    private IReadOnlyList<ApiError> Errors { get; set; } = [];

    private string? Message { get; set; }

    private bool IsLoading { get; set; }

    private bool IsGenerating { get; set; }

    private string? Query { get; set; }

    private string? IntentLabel { get; set; }

    private string SortBy { get; set; } = "score";

    private string OrderBy { get; set; } = "desc";

    private bool Regenerate { get; set; } = true;

    private bool CanOperate
        => !IsGuest && ProjectState.SelectedProject is not null && !IsGenerating;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        ProjectState.Changed += OnProjectStateChanged;
        await ProjectState.LoadAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (ProjectState.SelectedProject is not { } project)
        {
            Clusters = [];
            SelectedCluster = null;
            return;
        }

        IsLoading = true;
        Errors = [];
        var result = await ApiClient.GetTopicClustersAsync(
            project.ProjectId,
            Query,
            SortBy,
            OrderBy,
            intentLabel: IntentLabel,
            pageSize: 100);
        if (result.IsSuccess)
        {
            Clusters = result.Data ?? [];
        }
        else
        {
            Clusters = [];
            Errors = result.Errors;
        }

        IsLoading = false;
    }

    private async Task GenerateAsync()
    {
        if (IsGuest) return;
        if (ProjectState.SelectedProject is not { } project)
        {
            return;
        }

        IsGenerating = true;
        Errors = [];
        Message = null;
        var result = await ApiClient.GenerateTopicClustersAsync(project.ProjectId, new TopicClusterGenerateRequest(Regenerate));
        if (result.IsSuccess && result.Data is { } job)
        {
            Message = $"クラスタ生成ジョブを登録しました: {job.JobId:D}";
        }
        else
        {
            Errors = result.Errors;
        }

        IsGenerating = false;
    }

    private async Task SelectClusterAsync(Guid clusterId)
    {
        if (ProjectState.SelectedProject is not { } project)
        {
            return;
        }

        Errors = [];
        var result = await ApiClient.GetTopicClusterAsync(project.ProjectId, clusterId);
        if (result.IsSuccess)
        {
            SelectedCluster = result.Data;
        }
        else
        {
            SelectedCluster = null;
            Errors = result.Errors;
        }
    }

    private async Task GenerateBriefAsync(TopicClusterSummary cluster)
    {
        if (IsGuest) return;
        if (ProjectState.SelectedProject is not { } project)
        {
            return;
        }

        Errors = [];
        Message = null;
        var result = await ApiClient.GenerateBriefAsync(
            project.ProjectId,
            new GenerateBriefRequest(
                TargetKeyword: cluster.RepresentativeKeywordId.HasValue ? null : cluster.RepresentativeKeyword,
                TargetKeywordId: cluster.RepresentativeKeywordId,
                ClusterId: cluster.ClusterId,
                Title: cluster.ArticleCandidates.FirstOrDefault()?.Title ?? cluster.Name));
        if (result.IsSuccess && result.Data is { } job)
        {
            Message = $"記事ブリーフ生成ジョブを登録しました: {job.JobId:D}";
        }
        else
        {
            Errors = result.Errors;
        }
    }

    private void NavigateToBriefs()
        => Navigation.NavigateTo("/briefs");

    private async void OnProjectStateChanged()
    {
        await InvokeAsync(async () =>
        {
            await LoadAsync();
            StateHasChanged();
        });
    }

    public void Dispose()
        => ProjectState.Changed -= OnProjectStateChanged;
}
