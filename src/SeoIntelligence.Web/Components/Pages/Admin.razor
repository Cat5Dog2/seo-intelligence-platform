    private void ClearErrors()
    {
        Errors = [];
        Message = null;
    }

    private JsonElement? ParseJson(string? json, string target)
    {
        if (string.IsNullOrWhiteSpace(json))
        {
            return null;
        }

        try
        {
            using var document = JsonDocument.Parse(json);
            return document.RootElement.Clone();
        }
        catch (JsonException exception)
        {
            Errors = [new ApiError("Validation.Json.Invalid", exception.Message, target)];
            return null;
        }
    }

    private Guid? ParseNullableGuid(string? value, string target)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return null;
        }

        if (Guid.TryParse(value, out var parsed))
        {
            return parsed;
        }

        Errors = [new ApiError("Validation.Guid.Invalid", $"{target} must be a GUID.", target)];
        return null;
    }

    private DateTimeOffset? ParseDateTimeOffset(string? value, string target)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return null;
        }

        if (DateTimeOffset.TryParse(value, out var parsed))
        {
            return parsed;
        }

        Errors = [new ApiError("Validation.Date.Invalid", $"{target} must be ISO 8601 date time.", target)];
        return null;
    }

    private static IReadOnlyList<string> ParseEventTypes(string? value)
        => string.IsNullOrWhiteSpace(value)
            ? []
            : value.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    private static string FormatDateTime(DateTime value)
        => value.ToLocalTime().ToString("yyyy-MM-dd HH:mm");

