@page "/admin"
@page "/admin/audit"
@using System.Text.Json
@implements IDisposable
@inject ISeoIntelligenceApiClient ApiClient
@inject ProjectSelectionState ProjectState

<PageTitle>管理 - SEO Intelligence</PageTitle>

<div class="page-stack">
    <header class="page-header">
        <div>
            <h1>管理</h1>
            <p>Workspace、API認証情報、通知、ジョブ、監査ログ</p>
        </div>
        <button type="button" class="secondary-button" @onclick="LoadAllAsync">更新</button>
    </header>

    <ErrorSummary Errors="@Errors" Message="@Message" />

    <nav class="tab-bar" aria-label="管理メニュー">
        <button type="button" class="@TabClass(WorkspaceTab)" @onclick="@(() => SetTab(WorkspaceTab))">Workspace</button>
        <button type="button" class="@TabClass(CredentialTab)" data-testid="admin-credentials-tab" @onclick="@(() => SetTab(CredentialTab))">APIキー</button>
        <button type="button" class="@TabClass(CreditTab)" @onclick="@(() => SetTab(CreditTab))">クレジット</button>
        <button type="button" class="@TabClass(NotificationTab)" @onclick="@(() => SetTab(NotificationTab))">Discord通知</button>
        <button type="button" class="@TabClass(JobTab)" @onclick="@(() => SetTab(JobTab))">ジョブ</button>
        <button type="button" class="@TabClass(Phase2Tab)" @onclick="@(() => SetTab(Phase2Tab))">Phase 2運用</button>
        <button type="button" class="@TabClass(Phase3Tab)" @onclick="@(() => SetTab(Phase3Tab))">Phase 3連携</button>
        <button type="button" class="@TabClass(AuditTab)" @onclick="@(() => SetTab(AuditTab))">監査ログ</button>
    </nav>

    @if (ActiveTab == WorkspaceTab)
    {
        <AdminWorkspacePanel WorkspaceForm="@WorkspaceForm" WorkspaceStatus="@WorkspaceStatus" OnSave="SaveWorkspaceAsync" />
    }
    else if (ActiveTab == CredentialTab)
    {
        <AdminCredentialsPanel
            CredentialStatus="@CredentialStatus"
            EnabledStatuses="@EnabledStatuses"
            CredentialForm="@CredentialForm"
            RotateForm="@RotateForm"
            EditingCredentialId="@EditingCredentialId"
            RotatingCredentialId="@RotatingCredentialId"
            Credentials="@Credentials"
            CredentialColumns="@CredentialColumns"
            IsCredentialLoading="@IsCredentialLoading"
            OnStatusChanged="OnCredentialStatusChanged"
            OnReload="LoadCredentialsAsync"
            OnSave="SaveCredentialAsync"
            OnClear="ClearCredentialForm"
            OnRotate="RotateCredentialAsync"
            OnClearRotate="ClearRotateForm"
            OnEdit="EditCredential"
            OnStartRotate="StartRotateCredential"
            OnEnable="EnableCredentialAsync"
            OnDisable="DisableCredentialAsync" />
    }
    else if (ActiveTab == CreditTab)
    {
        <AdminCreditPanel
            ExternalCalls="@ExternalCalls"
            ExternalCallColumns="@ExternalCallColumns"
            IsExternalCallLoading="@IsExternalCallLoading"
            OnReload="LoadExternalCallsAsync" />
    }
    else if (ActiveTab == NotificationTab)
    {
        <AdminNotificationsPanel
            ChannelStatus="@ChannelStatus"
            DeliveryStatus="@DeliveryStatus"
            EnabledStatuses="@EnabledStatuses"
            DeliveryStatuses="@DeliveryStatuses"
            ChannelForm="@ChannelForm"
            EditingChannelId="@EditingChannelId"
            Channels="@Channels"
            Deliveries="@Deliveries"
            ChannelColumns="@ChannelColumns"
            DeliveryColumns="@DeliveryColumns"
            IsChannelLoading="@IsChannelLoading"
            IsDeliveryLoading="@IsDeliveryLoading"
            OnChannelStatusChanged="OnChannelStatusChanged"
            OnDeliveryStatusChanged="OnDeliveryStatusChanged"
            OnReload="LoadNotificationsAsync"
            OnSaveChannel="SaveChannelAsync"
            OnClearChannel="ClearChannelForm"
            OnEditChannel="EditChannel"
            OnTestChannel="TestChannelAsync"
            OnEnableChannel="EnableChannelAsync"
            OnDisableChannel="DisableChannelAsync"
            OnRetryDelivery="RetryDeliveryAsync" />
    }
    else if (ActiveTab == JobTab)
    {
        <AdminJobsPanel />
    }
    else if (ActiveTab == Phase2Tab)
    {
        <AdminPhase2Panel
            SelectedProjectName="@ProjectState.SelectedProject?.Name"
            Phase2JobType="@Phase2JobType"
            Phase2JobTypeChanged="SetPhase2JobType"
            Phase2JobTypeOptions="@Phase2JobTypeOptions"
            Phase2JobTitle="@Phase2JobTitle"
            Phase2Alerts="@Phase2Alerts"
            Phase2AlertEvents="@Phase2AlertEvents"
            Phase2RankAlertDeliveries="@Phase2RankAlertDeliveries"
            Phase2AlertColumns="@Phase2AlertColumns"
            Phase2AlertEventColumns="@Phase2AlertEventColumns"
            DeliveryColumns="@DeliveryColumns"
            IsPhase2Loading="@IsPhase2Loading"
            OnReload="LoadPhase2OperationsAsync" />
    }
    else if (ActiveTab == Phase3Tab)
    {
        <AdminPhase3Panel
            SelectedProjectName="@ProjectState.SelectedProject?.Name"
            IsProjectUnavailable="@(ProjectState.SelectedProject is null)"
            ConnectorStatus="@ConnectorStatus"
            EnabledStatuses="@EnabledStatuses"
            ConnectorForm="@ConnectorForm"
            EditingConnectorId="@EditingConnectorId"
            SelectedConnectorId="@SelectedConnectorId"
            Connectors="@Connectors"
            ConnectorRuns="@ConnectorRuns"
            ConnectorColumns="@ConnectorColumns"
            ConnectorRunColumns="@ConnectorRunColumns"
            IsConnectorLoading="@IsConnectorLoading"
            IsConnectorRunLoading="@IsConnectorRunLoading"
            OnConnectorStatusChanged="OnConnectorStatusChanged"
            OnReload="LoadPhase3OperationsAsync"
            OnSaveConnector="SaveConnectorAsync"
            OnClearConnector="ClearConnectorForm"
            OnEditConnector="EditConnector"
            OnTestConnector="TestConnectorAsync"
            OnLoadConnectorRuns="LoadConnectorRunsAsync"
            OnDisableConnector="DisableConnectorAsync" />
    }
    else if (ActiveTab == AuditTab)
    {
        <AdminAuditPanel
            AuditForm="@AuditForm"
            AuditLogs="@AuditLogs"
            AuditColumns="@AuditColumns"
            IsAuditLoading="@IsAuditLoading"
            OnSearch="LoadAuditLogsAsync" />
    }
</div>

@code {
    private const string WorkspaceTab = "workspace";
    private const string CredentialTab = "credential";
    private const string CreditTab = "credit";
    private const string NotificationTab = "notification";
    private const string JobTab = "job";
    private const string Phase2Tab = "phase2";
    private const string Phase3Tab = "phase3";
    private const string AuditTab = "audit";

    private static readonly IReadOnlyList<StatusFilterOption> EnabledStatuses =
    [
        new("active", "active"),
        new("disabled", "disabled"),
        new("all", "all")
    ];

    private static readonly IReadOnlyList<StatusFilterOption> DeliveryStatuses =
    [
        new("all", "all"),
        new("pending", "pending"),
        new("retrying", "retrying"),
        new("succeeded", "succeeded"),
        new("failed", "failed")
    ];

    private static readonly IReadOnlyList<string> Phase2JobTypeOptions =
    [
        "TopicClusterGenerateJob",
        "CompetitorRefreshJob",
        "ContentAnalyzeJob",
        "GenerateBriefJob",
        "ArticleBriefExportJob",
        "RegisterRankCheckJob",
        "PollRankStatusJob",
        "FetchRankResultsJob",
        "RankAlertEvaluateJob"
    ];

    private static readonly IReadOnlyList<DataTableColumn<ApiCredentialDetails>> CredentialColumns =
    [
        new("Provider", credential => credential.Provider),
        new("Key Ref", credential => credential.KeyRef),
        new("状態", credential => credential.Status),
        new("更新", credential => FormatDateTime(credential.UpdatedAt))
    ];

    private static readonly IReadOnlyList<DataTableColumn<ExternalApiCallDetails>> ExternalCallColumns =
    [
        new("Provider", call => call.Provider),
        new("Endpoint", call => call.Endpoint),
        new("Status", call => call.StatusCode.ToString()),
        new("Credit", call => call.ConsumedCredit.ToString("0.##")),
        new("Cache", call => call.CacheHit ? "hit" : "miss"),
        new("Created", call => FormatDateTime(call.CreatedAt))
    ];

    private static readonly IReadOnlyList<DataTableColumn<NotificationChannelDetails>> ChannelColumns =
    [
        new("名称", channel => channel.Name),
        new("Type", channel => channel.ChannelType),
        new("Webhook Ref", channel => channel.WebhookSecretRef),
        new("Events", channel => string.Join(", ", channel.EventTypes)),
        new("状態", channel => channel.Status)
    ];

    private static readonly IReadOnlyList<DataTableColumn<NotificationDeliveryDetails>> DeliveryColumns =
    [
        new("Event", delivery => delivery.EventType),
        new("状態", delivery => delivery.Status),
        new("Retry", delivery => delivery.RetryCount.ToString()),
        new("Error", delivery => delivery.ErrorMessage),
        new("Created", delivery => FormatDateTime(delivery.CreatedAt))
    ];

    private static readonly IReadOnlyList<DataTableColumn<AuditLogDetails>> AuditColumns =
    [
        new("Action", audit => audit.Action),
        new("Resource", audit => $"{audit.ResourceType}:{audit.ResourceId}"),
        new("Actor", audit => audit.Actor),
        new("Correlation", audit => audit.CorrelationId),
        new("Created", audit => FormatDateTime(audit.CreatedAt))
    ];

    private static readonly IReadOnlyList<DataTableColumn<RankAlertDetails>> Phase2AlertColumns =
    [
        new("Type", alert => alert.AlertType),
        new("Status", alert => alert.Status),
        new("Channel", alert => alert.NotificationChannelId?.ToString("D")),
        new("Last Triggered", alert => alert.LastTriggeredAt.HasValue ? FormatDateTime(alert.LastTriggeredAt.Value) : "-"),
        new("Updated", alert => FormatDateTime(alert.UpdatedAt))
    ];

    private static readonly IReadOnlyList<DataTableColumn<RankAlertEventDetails>> Phase2AlertEventColumns =
    [
        new("Event", alertEvent => alertEvent.EventType),
        new("Keyword", alertEvent => alertEvent.Keyword),
        new("Job", alertEvent => alertEvent.JobId?.ToString("D")),
        new("Delivery", alertEvent => alertEvent.NotificationDeliveryId?.ToString("D")),
        new("Triggered", alertEvent => FormatDateTime(alertEvent.TriggeredAt))
    ];

    private static readonly IReadOnlyList<DataTableColumn<ConnectorSettingsDetails>> ConnectorColumns =
    [
        new("Type", connector => connector.ConnectorType),
        new("名称", connector => connector.Name),
        new("Auth Ref", connector => connector.AuthRef),
        new("状態", connector => connector.Status),
        new("Updated", connector => FormatDateTime(connector.UpdatedAt))
    ];

    private static readonly IReadOnlyList<DataTableColumn<ConnectorRunDetails>> ConnectorRunColumns =
    [
        new("Run Type", run => run.RunType),
        new("状態", run => run.Status),
        new("Started", run => FormatDateTime(run.StartedAt)),
        new("Completed", run => run.CompletedAt.HasValue ? FormatDateTime(run.CompletedAt.Value) : "-"),
        new("Summary", run => JsonSummary(run.ResultSummary)),
        new("Error", run => run.Error.HasValue ? JsonSummary(run.Error.Value) : "-")
    ];

    private string ActiveTab { get; set; } = WorkspaceTab;

    private AdminWorkspaceFormModel WorkspaceForm { get; set; } = new();

    private string WorkspaceStatus { get; set; } = "未読込";

    private IReadOnlyList<ApiCredentialDetails> Credentials { get; set; } = [];

    private IReadOnlyList<ExternalApiCallDetails> ExternalCalls { get; set; } = [];

    private IReadOnlyList<NotificationChannelDetails> Channels { get; set; } = [];

    private IReadOnlyList<NotificationDeliveryDetails> Deliveries { get; set; } = [];

    private IReadOnlyList<AuditLogDetails> AuditLogs { get; set; } = [];

    private IReadOnlyList<RankAlertDetails> Phase2Alerts { get; set; } = [];

    private IReadOnlyList<RankAlertEventDetails> Phase2AlertEvents { get; set; } = [];

    private IReadOnlyList<NotificationDeliveryDetails> Phase2RankAlertDeliveries { get; set; } = [];

    private IReadOnlyList<ConnectorSettingsDetails> Connectors { get; set; } = [];

    private IReadOnlyList<ConnectorRunDetails> ConnectorRuns { get; set; } = [];

    private IReadOnlyList<ApiError> Errors { get; set; } = [];

    private string? Message { get; set; }

    private bool IsCredentialLoading { get; set; }

    private bool IsExternalCallLoading { get; set; }

    private bool IsChannelLoading { get; set; }

    private bool IsDeliveryLoading { get; set; }

    private bool IsAuditLoading { get; set; }

    private bool IsPhase2Loading { get; set; }

    private bool IsConnectorLoading { get; set; }

    private bool IsConnectorRunLoading { get; set; }

    private string CredentialStatus { get; set; } = "active";

    private string ChannelStatus { get; set; } = "active";

    private string DeliveryStatus { get; set; } = "all";

    private string Phase2JobType { get; set; } = "RegisterRankCheckJob";

    private string Phase2JobTitle => $"Phase 2ジョブ: {Phase2JobType}";

    private string ConnectorStatus { get; set; } = "active";

    private Guid? EditingCredentialId { get; set; }

    private Guid? RotatingCredentialId { get; set; }

    private Guid? EditingChannelId { get; set; }

    private Guid? EditingConnectorId { get; set; }

    private Guid? SelectedConnectorId { get; set; }

    private AdminCredentialFormModel CredentialForm { get; set; } = new();

    private AdminRotateCredentialFormModel RotateForm { get; set; } = new();

    private AdminChannelFormModel ChannelForm { get; set; } = new();

    private AdminConnectorFormModel ConnectorForm { get; set; } = new();

    private AdminAuditSearchFormModel AuditForm { get; set; } = new();

    [SupplyParameterFromQuery(Name = "resourceType")]
    public string? QueryResourceType { get; set; }

    [SupplyParameterFromQuery(Name = "resourceId")]
    public string? QueryResourceId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        ProjectState.Changed += OnProjectStateChanged;
        await ProjectState.LoadAsync();
        await LoadAllAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrWhiteSpace(QueryResourceType) || !string.IsNullOrWhiteSpace(QueryResourceId))
        {
            ActiveTab = AuditTab;
            AuditForm.ResourceType = QueryResourceType;
            AuditForm.ResourceId = QueryResourceId;
            await LoadAuditLogsAsync();
        }
    }

    private async Task LoadAllAsync()
    {
        ClearErrors();
        await LoadWorkspaceAsync();
        await LoadCredentialsAsync();
        await LoadExternalCallsAsync();
        await LoadNotificationsAsync();
        await LoadPhase2OperationsAsync();
        await LoadPhase3OperationsAsync();
        await LoadAuditLogsAsync();
    }

    private async Task LoadWorkspaceAsync()
    {
        var result = await ApiClient.GetWorkspaceAsync();
        if (result.IsSuccess && result.Data is { } workspace)
        {
            WorkspaceStatus = workspace.Status;
            WorkspaceForm = new AdminWorkspaceFormModel
            {
                Name = workspace.Name,
                DefaultLocation = workspace.DefaultLocation,
                DefaultLanguage = workspace.DefaultLanguage,
                RetentionSettingsJson = workspace.RetentionSettings.ValueKind == JsonValueKind.Undefined ? "{}" : workspace.RetentionSettings.GetRawText(),
                NotificationDefaultsJson = workspace.NotificationDefaults.ValueKind == JsonValueKind.Undefined ? "{}" : workspace.NotificationDefaults.GetRawText()
            };
        }
        else
        {
            Errors = result.Errors;
        }
    }

    private async Task SaveWorkspaceAsync()
    {
        ClearErrors();
        var retention = ParseJson(WorkspaceForm.RetentionSettingsJson, "Retention JSON");
        var notificationDefaults = ParseJson(WorkspaceForm.NotificationDefaultsJson, "Notification Defaults JSON");
        if (Errors.Count > 0)
        {
            return;
        }

        var result = await ApiClient.UpdateWorkspaceAsync(
            new WorkspaceUpdateRequest(
                WorkspaceForm.Name,
                WorkspaceForm.DefaultLocation,
                WorkspaceForm.DefaultLanguage,
                retention,
                notificationDefaults));
        if (result.IsSuccess)
        {
            Message = "保存しました。";
            await LoadWorkspaceAsync();
        }
        else
        {
            Errors = result.Errors;
        }
    }

    private async Task LoadCredentialsAsync()
    {
        IsCredentialLoading = true;
        var result = await ApiClient.SearchApiCredentialsAsync(CredentialStatus, pageSize: 100);
        if (result.IsSuccess)
        {
            Credentials = result.Data ?? [];
        }
        else
        {
            Errors = result.Errors;
            Credentials = [];
        }

        IsCredentialLoading = false;
    }

    private async Task SaveCredentialAsync()
    {
        ClearErrors();
        ApiClientResult<ApiCredentialDetails> result = EditingCredentialId.HasValue
            ? await ApiClient.UpdateApiCredentialAsync(EditingCredentialId.Value, new ApiCredentialUpdateRequest(CredentialForm.Provider))
            : await ApiClient.CreateApiCredentialAsync(new ApiCredentialCreateRequest(CredentialForm.Provider, CredentialForm.KeyRef, CredentialForm.SecretValue));
        if (result.IsSuccess)
        {
            ClearCredentialForm();
            await LoadCredentialsAsync();
        }
        else
        {
            Errors = result.Errors;
        }
    }

    private void EditCredential(ApiCredentialDetails credential)
    {
        EditingCredentialId = credential.CredentialId;
        CredentialForm = new AdminCredentialFormModel
        {
            Provider = credential.Provider,
            KeyRef = credential.KeyRef
        };
    }

    private void StartRotateCredential(Guid credentialId)
    {
        RotatingCredentialId = credentialId;
        RotateForm = new AdminRotateCredentialFormModel();
    }

    private async Task RotateCredentialAsync()
    {
        if (!RotatingCredentialId.HasValue)
        {
            return;
        }

        var result = await ApiClient.RotateApiCredentialAsync(
            RotatingCredentialId.Value,
            new ApiCredentialRotateRequest(RotateForm.NewKeyRef, RotateForm.NewSecretValue));
        if (result.IsSuccess)
        {
            ClearRotateForm();
            await LoadCredentialsAsync();
        }
        else
        {
            Errors = result.Errors;
        }
    }

    private async Task DisableCredentialAsync(Guid credentialId)
    {
        var result = await ApiClient.DisableApiCredentialAsync(credentialId);
        await CompleteCredentialActionAsync(result);
    }

    private async Task EnableCredentialAsync(Guid credentialId)
    {
        var result = await ApiClient.EnableApiCredentialAsync(credentialId);
        await CompleteCredentialActionAsync(result);
    }

    private async Task CompleteCredentialActionAsync(ApiClientResult<ApiCredentialDetails> result)
    {
        if (result.IsSuccess)
        {
            await LoadCredentialsAsync();
        }
        else
        {
            Errors = result.Errors;
        }
    }

    private async Task LoadExternalCallsAsync()
    {
        IsExternalCallLoading = true;
        var result = await ApiClient.SearchExternalApiCallsAsync(pageSize: 200);
        if (result.IsSuccess)
        {
            ExternalCalls = result.Data ?? [];
        }
        else
        {
            Errors = result.Errors;
            ExternalCalls = [];
        }

        IsExternalCallLoading = false;
    }

    private async Task LoadNotificationsAsync()
    {
        await LoadChannelsAsync();
        await LoadDeliveriesAsync();
    }

    private async Task LoadChannelsAsync()
    {
        IsChannelLoading = true;
        var result = await ApiClient.SearchNotificationChannelsAsync(ChannelStatus, pageSize: 100);
        if (result.IsSuccess)
        {
            Channels = result.Data ?? [];
        }
        else
        {
            Errors = result.Errors;
            Channels = [];
        }

        IsChannelLoading = false;
    }

    private async Task LoadDeliveriesAsync()
    {
        IsDeliveryLoading = true;
        var result = await ApiClient.SearchNotificationDeliveriesAsync(DeliveryStatus, pageSize: 100);
        if (result.IsSuccess)
        {
            Deliveries = result.Data ?? [];
        }
        else
        {
            Errors = result.Errors;
            Deliveries = [];
        }

        IsDeliveryLoading = false;
    }

    private async Task SaveChannelAsync()
    {
        ClearErrors();
        var projectId = ParseNullableGuid(ChannelForm.ProjectId, "Project Id");
        if (Errors.Count > 0)
        {
            return;
        }

        var eventTypes = ParseEventTypes(ChannelForm.EventTypes);
        ApiClientResult<NotificationChannelDetails> result = EditingChannelId.HasValue
            ? await ApiClient.UpdateNotificationChannelAsync(
                EditingChannelId.Value,
                new NotificationChannelUpdateRequest(projectId, ChannelForm.ChannelType, ChannelForm.Name, ChannelForm.WebhookSecretRef, eventTypes))
            : await ApiClient.CreateNotificationChannelAsync(
                new NotificationChannelCreateRequest(projectId, ChannelForm.ChannelType, ChannelForm.Name, ChannelForm.WebhookSecretRef, eventTypes));
        if (result.IsSuccess)
        {
            ClearChannelForm();
            await LoadChannelsAsync();
        }
        else
        {
            Errors = result.Errors;
        }
    }

    private void EditChannel(NotificationChannelDetails channel)
    {
        EditingChannelId = channel.ChannelId;
        ChannelForm = new AdminChannelFormModel
        {
            Name = channel.Name,
            ChannelType = channel.ChannelType,
            ProjectId = channel.ProjectId?.ToString("D"),
            WebhookSecretRef = channel.WebhookSecretRef,
            EventTypes = string.Join(", ", channel.EventTypes)
        };
    }

    private async Task TestChannelAsync(Guid channelId)
    {
        var result = await ApiClient.TestNotificationChannelAsync(channelId);
        if (result.IsSuccess)
        {
            await LoadDeliveriesAsync();
        }
        else
        {
            Errors = result.Errors;
        }
    }

    private async Task DisableChannelAsync(Guid channelId)
    {
        var result = await ApiClient.DisableNotificationChannelAsync(channelId);
        await CompleteChannelActionAsync(result);
    }

    private async Task EnableChannelAsync(Guid channelId)
    {
        var result = await ApiClient.EnableNotificationChannelAsync(channelId);
        await CompleteChannelActionAsync(result);
    }

    private async Task CompleteChannelActionAsync(ApiClientResult<NotificationChannelDetails> result)
    {
        if (result.IsSuccess)
        {
            await LoadChannelsAsync();
        }
        else
        {
            Errors = result.Errors;
        }
    }

    private async Task RetryDeliveryAsync(Guid deliveryId)
    {
        var result = await ApiClient.RetryNotificationDeliveryAsync(deliveryId);
        if (result.IsSuccess)
        {
            await LoadDeliveriesAsync();
        }
        else
        {
            Errors = result.Errors;
        }
    }

    private async Task LoadAuditLogsAsync()
    {
        IsAuditLoading = true;
        ClearErrors();
        var result = await ApiClient.SearchAuditLogsAsync(new AuditLogSearchParameters(
            AuditForm.Q,
            AuditForm.Actor,
            AuditForm.ResourceType,
            AuditForm.ResourceId,
            AuditForm.CorrelationId,
            ParseDateTimeOffset(AuditForm.From, "From"),
            ParseDateTimeOffset(AuditForm.To, "To"),
            PageSize: 100));
        if (Errors.Count > 0)
        {
            IsAuditLoading = false;
            return;
        }

        if (result.IsSuccess)
        {
            AuditLogs = result.Data ?? [];
        }
        else
        {
            Errors = result.Errors;
            AuditLogs = [];
        }

        IsAuditLoading = false;
    }

    private async Task LoadPhase2OperationsAsync()
    {
        IsPhase2Loading = true;
        if (ProjectState.SelectedProject is not { } project)
        {
            Phase2Alerts = [];
            Phase2AlertEvents = [];
            Phase2RankAlertDeliveries = [];
            IsPhase2Loading = false;
            return;
        }

        var alerts = await ApiClient.SearchRankAlertsAsync(project.ProjectId, status: "all", pageSize: 50);
        if (alerts.IsSuccess)
        {
            Phase2Alerts = alerts.Data ?? [];
        }
        else
        {
            Phase2Alerts = [];
            Errors = alerts.Errors;
        }

        var alertEvents = await ApiClient.SearchRankAlertEventsAsync(project.ProjectId, pageSize: 50);
        if (alertEvents.IsSuccess)
        {
            Phase2AlertEvents = alertEvents.Data ?? [];
        }
        else
        {
            Phase2AlertEvents = [];
            Errors = alertEvents.Errors;
        }

        var deliveries = await ApiClient.SearchNotificationDeliveriesAsync("all", q: "rank_alert", pageSize: 50);
        if (deliveries.IsSuccess)
        {
            Phase2RankAlertDeliveries = (deliveries.Data ?? [])
                .Where(delivery => string.Equals(delivery.EventType, "rank_alert", StringComparison.Ordinal))
                .ToArray();
        }
        else
        {
            Phase2RankAlertDeliveries = [];
            Errors = deliveries.Errors;
        }

        IsPhase2Loading = false;
    }

    private async Task LoadPhase3OperationsAsync()
    {
        await LoadConnectorsAsync();
        if (SelectedConnectorId.HasValue)
        {
            await LoadConnectorRunsAsync(SelectedConnectorId.Value);
        }
    }

    private async Task LoadConnectorsAsync()
    {
        IsConnectorLoading = true;
        if (ProjectState.SelectedProject is not { } project)
        {
            Connectors = [];
            ConnectorRuns = [];
            SelectedConnectorId = null;
            IsConnectorLoading = false;
            return;
        }

        var result = await ApiClient.SearchConnectorsAsync(project.ProjectId, ConnectorStatus, pageSize: 100);
        if (result.IsSuccess)
        {
            Connectors = result.Data ?? [];
        }
        else
        {
            Connectors = [];
            Errors = result.Errors;
        }

        IsConnectorLoading = false;
    }

    private async Task LoadConnectorRunsAsync(Guid connectorId)
    {
        IsConnectorRunLoading = true;
        SelectedConnectorId = connectorId;
        if (ProjectState.SelectedProject is not { } project)
        {
            ConnectorRuns = [];
            IsConnectorRunLoading = false;
            return;
        }

        var result = await ApiClient.GetConnectorRunsAsync(project.ProjectId, connectorId, pageSize: 50);
        if (result.IsSuccess)
        {
            ConnectorRuns = result.Data ?? [];
        }
        else
        {
            ConnectorRuns = [];
            Errors = result.Errors;
        }

        IsConnectorRunLoading = false;
    }

    private async Task SaveConnectorAsync()
    {
        ClearErrors();
        if (ProjectState.SelectedProject is not { } project)
        {
            return;
        }

        var settings = ParseJson(ConnectorForm.SettingsJson, "settings JSON");
        if (Errors.Count > 0)
        {
            return;
        }

        var request = new ConnectorSettingsRequest(
            ConnectorForm.ConnectorType,
            ConnectorForm.Name,
            ConnectorForm.AuthRef,
            settings,
            ConnectorForm.Status);
        ApiClientResult<ConnectorSettingsDetails> result = EditingConnectorId.HasValue
            ? await ApiClient.UpdateConnectorAsync(project.ProjectId, EditingConnectorId.Value, request)
            : await ApiClient.CreateConnectorAsync(project.ProjectId, request);
        if (result.IsSuccess && result.Data is { } connector)
        {
            Message = "外部連携スタブ設定を保存しました。";
            EditingConnectorId = connector.ConnectorId;
            SelectedConnectorId = connector.ConnectorId;
            await LoadConnectorsAsync();
        }
        else
        {
            Errors = result.Errors;
        }
    }

    private void EditConnector(ConnectorSettingsDetails connector)
    {
        EditingConnectorId = connector.ConnectorId;
        SelectedConnectorId = connector.ConnectorId;
        ConnectorForm = new AdminConnectorFormModel
        {
            ConnectorType = connector.ConnectorType,
            Name = connector.Name,
            AuthRef = connector.AuthRef,
            Status = connector.Status,
            SettingsJson = connector.Settings.ValueKind == JsonValueKind.Undefined ? "{}" : connector.Settings.GetRawText()
        };
    }

    private async Task TestConnectorAsync(Guid connectorId)
    {
        ClearErrors();
        if (ProjectState.SelectedProject is not { } project)
        {
            return;
        }

        var result = await ApiClient.TestConnectorAsync(project.ProjectId, connectorId);
        if (result.IsSuccess && result.Data is { } run)
        {
            SelectedConnectorId = connectorId;
            Message = $"外部連携スタブ接続テストを実行しました: {run.RunId:D}";
            await LoadConnectorRunsAsync(connectorId);
        }
        else
        {
            Errors = result.Errors;
        }
    }

    private async Task DisableConnectorAsync(Guid connectorId)
    {
        ClearErrors();
        if (ProjectState.SelectedProject is not { } project)
        {
            return;
        }

        var result = await ApiClient.DisableConnectorAsync(project.ProjectId, connectorId);
        if (result.IsSuccess)
        {
            Message = "外部連携スタブ設定を無効化しました。";
            await LoadConnectorsAsync();
        }
        else
        {
            Errors = result.Errors;
        }
    }

