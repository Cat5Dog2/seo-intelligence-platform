@page "/keywords"
@attribute [Authorize(Policy = ApplicationPolicies.RequireWorkspaceAccess)]
@using System.Text.Json
@inherits WorkspaceComponentBase
@implements IDisposable
@inject ISeoIntelligenceApiClient ApiClient
@inject ProjectSelectionState ProjectState

<PageTitle>キーワード探索 - SEO Intelligence</PageTitle>

<div class="page-stack">
    <header class="page-header">
        <div>
            <h1>キーワード探索</h1>
            <p class="project-context">選択中プロジェクト: @(ProjectState.SelectedProject?.Name ?? "未選択")</p>
        </div>
    </header>

    <ErrorSummary Errors="@Errors" />
    @if (!ProjectState.IsLoading && ProjectState.SelectedProject is null && ProjectState.ErrorMessage is null)
    {
        <GettingStarted />
    }
    @if (!string.IsNullOrWhiteSpace(Message))
    {
        <div class="state-row" role="status" data-testid="keyword-status-message">
            @Message
            @if (VolumeResultHref is { } href) { <a class="primary-button" href="@href">検索ボリュームの結果を見る</a> }
        </div>
    }

    <section class="panel">
        <div class="section-heading">
            <h2>探索条件</h2>
            <span class="muted">@LocationLanguageLabel</span>
        </div>
        <div class="form-grid dense-form">
            <label class="field wide-field">
                <span>シードキーワード</span>
                <input data-testid="keyword-seed-input" @bind="DiscoveryForm.SeedKeyword" @bind:event="oninput" disabled="@(ProjectState.SelectedProject is null)" />
            </label>
        </div>
        <div class="button-row">
            <button type="button" class="primary-button" data-testid="keyword-discovery-run-button" @onclick="DiscoverAsync" disabled="@(!CanRunDiscovery)">キーワードを探す</button>
        </div>
        <details class="advanced-options">
            <summary>詳細条件</summary>
            @if (IsGuest)
            {
                <p class="muted">デモではGoogleの候補語を5件表示します。ソース・件数・絞り込みの指定は通常ログインで利用できます。</p>
            }
            else
            {
        <div class="form-grid dense-form">
            <label class="field">
                <span>取得件数の上限</span>
                <input data-testid="keyword-limit-input" type="number" min="1" max="25000" @bind="DiscoveryForm.Limit" disabled="@(ProjectState.SelectedProject is null)" />
            </label>
            <label class="field">
                <span>並べ替え項目</span>
                <select @bind="DiscoveryForm.SortBy" disabled="@(ProjectState.SelectedProject is null)">
                    <option value="searchVolume">検索ボリューム</option>
                    <option value="seoDifficulty">SEO難易度</option>
                    <option value="cpc">CPC</option>
                    <option value="competition">広告競合性</option>
                    <option value="firstSeenRange">出現時期</option>
                    <option value="keyword">キーワード</option>
                    <option value="suggestClass">候補の種類</option>
                </select>
            </label>
            <label class="field">
                <span>並び順</span>
                <select @bind="DiscoveryForm.OrderBy" disabled="@(ProjectState.SelectedProject is null)">
                    <option value="desc">降順</option>
                    <option value="asc">昇順</option>
                </select>
            </label>
            <label class="check-option compact-check">
                <input type="checkbox" data-testid="keyword-sync-preferred-input" @bind="DiscoveryForm.SyncPreferred" disabled="@(ProjectState.SelectedProject is null)" />
                <span>同期希望</span>
            </label>
        </div>

        <div class="option-grid">
            <fieldset>
                <legend>取得ソース</legend>
                <div class="check-list">
                    @foreach (var source in SourceOptions)
                    {
                        <label class="check-option">
                            <input type="checkbox" checked="@DiscoveryForm.Sources.Contains(source.Value)" @onchange="args => ToggleOption(DiscoveryForm.Sources, source.Value, args)" disabled="@(ProjectState.SelectedProject is null)" />
                            <span>@source.Label</span>
                        </label>
                    }
                </div>
            </fieldset>
            <fieldset>
                <legend>検索エンジン</legend>
                <div class="check-list">
                    @foreach (var engine in EngineOptions)
                    {
                        <label class="check-option">
                            <input type="checkbox" checked="@DiscoveryForm.Engines.Contains(engine.Value)" @onchange="args => ToggleOption(DiscoveryForm.Engines, engine.Value, args)" disabled="@(ProjectState.SelectedProject is null)" />
                            <span>@engine.Label</span>
                        </label>
                    }
                </div>
            </fieldset>
        </div>

        <div class="form-grid dense-form">
            <label class="field">
                <span>検索ボリュームの下限</span>
                <input type="number" step="1" @bind="DiscoveryForm.MinSearchVolume" disabled="@(ProjectState.SelectedProject is null)" />
            </label>
            <label class="field">
                <span>検索ボリュームの上限</span>
                <input type="number" step="1" @bind="DiscoveryForm.MaxSearchVolume" disabled="@(ProjectState.SelectedProject is null)" />
            </label>
            <label class="field">
                <span>SEO難易度の下限</span>
                <input type="number" step="0.1" @bind="DiscoveryForm.MinSeoDifficulty" disabled="@(ProjectState.SelectedProject is null)" />
            </label>
            <label class="field">
                <span>SEO難易度の上限</span>
                <input type="number" step="0.1" @bind="DiscoveryForm.MaxSeoDifficulty" disabled="@(ProjectState.SelectedProject is null)" />
            </label>
            <label class="field">
                <span>CPCの下限</span>
                <input type="number" step="0.01" @bind="DiscoveryForm.MinCpc" disabled="@(ProjectState.SelectedProject is null)" />
            </label>
            <label class="field">
                <span>広告競合性の上限</span>
                <input type="number" step="0.1" @bind="DiscoveryForm.MaxCompetition" disabled="@(ProjectState.SelectedProject is null)" />
            </label>
            <label class="field">
                <span>出現時期</span>
                <input @bind="DiscoveryForm.FirstSeenRange" disabled="@(ProjectState.SelectedProject is null)" />
            </label>
            <label class="field">
                <span>候補の種類</span>
                <input @bind="DiscoveryForm.SuggestClass" disabled="@(ProjectState.SelectedProject is null)" />
            </label>
            <label class="field">
                <span>含む語句</span>
                <input @bind="DiscoveryForm.IncludeTerms" disabled="@(ProjectState.SelectedProject is null)" />
            </label>
            <label class="field">
                <span>除外語句</span>
                <input @bind="DiscoveryForm.ExcludeTerms" disabled="@(ProjectState.SelectedProject is null)" />
            </label>
        </div>
            }
        </details>
    </section>

    @if (DiscoveryJob is not null)
    {
        <section class="panel">
            <div class="section-heading">
                <h2>探索ジョブ</h2>
                <button type="button" class="secondary-button" @onclick="RefreshDiscoveryJobAsync">状態更新</button>
                @if (DiscoveryJob.Status == "failed_retryable")
                {
                    <button type="button" class="secondary-button" @onclick="RetryDiscoveryJobAsync">失敗したソースを再試行</button>
                }
            </div>
            <div class="job-status-card">
                <span>キーワード探索</span>
                <strong>@UiText.Status(DiscoveryJob.Status)</strong>
                <progress max="100" value="@DiscoveryJob.Progress"></progress>
                <span>@DiscoveryJob.Progress%</span>
            </div>
        </section>
    }

    @if (SourceStatuses.Count > 0)
    {
        <details class="panel advanced-options">
            <summary>取得元ごとの状態</summary>
            <DataTable Items="@SourceStatuses" Columns="@SourceStatusColumns" EmptyText="ソース状態はありません。" />
        </details>
    }

    <section class="panel" data-testid="keyword-candidates-section">
        <div class="section-heading">
            <h2>候補語</h2>
            <span class="muted">@CandidateCountLabel</span>
        <div class="toolbar">
            <button type="button" class="secondary-button" data-testid="keyword-candidates-search-volume-button" @onclick="RegisterCandidateSearchVolumeAsync" disabled="@(!CanSendCandidates)">検索ボリューム調査へ送る</button>
            <button type="button" class="secondary-button" data-testid="keyword-candidates-export-button" @onclick="CreateCandidateExportAsync" disabled="@(!CanExportCandidates)">CSV出力</button>
        </div>
        </div>
        <DataTable Items="@Candidates" Columns="@CandidateColumns" MobileCards="true" IsLoading="@IsLoading" EmptyText="候補語はありません。" />
    </section>
    @if (ProjectState.SelectedProject is not null)
    {
        <section class="panel">
            <JobProgressPanel @ref="ExportPanel" Title="CSV出力" ProjectScoped="true" JobType="DataExportJob" />
        </section>
        <details class="panel research-history">
            <summary>保存済みの探索を開く</summary>
            <JobProgressPanel @ref="DiscoveryPanel" Title="探索履歴" ProjectScoped="true" JobType="KeywordDiscoveryJob" />
        </details>
    }
</div>

@code {
    private JobProgressPanel? ExportPanel;
    private JobProgressPanel? DiscoveryPanel;
    private string? VolumeResultHref;
    [SupplyParameterFromQuery(Name = "jobId")] public string? InitialJobId { get; set; }
    [SupplyParameterFromQuery(Name = "projectId")] public string? InitialProjectId { get; set; }
    private string? LoadedQuery;
    private Guid? SelectedProjectId;
    private bool ApplyingQuery;

    private static readonly JsonSerializerOptions JsonOptions = new(JsonSerializerDefaults.Web);

    private static readonly IReadOnlyList<OptionItem> SourceOptions =
    [
        new("suggest", "サジェスト"),
        new("related", "関連キーワード"),
        new("other", "LSI/PAA"),
        new("question", "FAQ"),
        new("ranking", "同時ランクイン")
    ];

    private static readonly IReadOnlyList<OptionItem> EngineOptions =
    [
        new("google", "Google"),
        new("bing", "Bing"),
        new("youtube", "YouTube"),
        new("amazon", "Amazon"),
        new("rakuten", "楽天"),
        new("googleShopping", "Shopping"),
        new("googleImage", "Image")
    ];

    private static readonly IReadOnlyList<DataTableColumn<KeywordCandidate>> CandidateColumns =
    [
        new("キーワード", candidate => candidate.Keyword),
        new("取得元", candidate => UiText.DiscoverySource(candidate.Source)),
        new("候補の種類", candidate => candidate.SuggestClass),
        new("検索ボリューム", candidate => FormatNullable(candidate.SearchVolume), "table-number"),
        new("SEO難易度", candidate => FormatNullable(candidate.SeoDifficulty), "table-number"),
        new("CPC", candidate => FormatNullable(candidate.Cpc), "table-number"),
        new("広告競合性", candidate => FormatNullable(candidate.Competition), "table-number"),
        new("出現時期", candidate => candidate.FirstSeenRange),
        new("スコア", candidate => FormatNullable(candidate.OpportunityScore), "table-number")
    ];

    private static readonly IReadOnlyList<DataTableColumn<KeywordDiscoverySourceStatus>> SourceStatusColumns =
    [
        new("取得元", status => UiText.DiscoverySource(status.Source)),
        new("状態", status => UiText.Status(status.Status), "table-status"),
        new("件数", status => status.CandidateCount.ToString(), "table-number"),
        new("消費クレジット", status => status.ConsumedCredit.ToString("0.##"), "table-number"),
        new("メッセージ", status => status.Message)
    ];

    private DiscoveryFormModel DiscoveryForm { get; set; } = new();

    private KeywordDiscoveryResult? DiscoveryResult { get; set; }

    private JobDetails? DiscoveryJob { get; set; }

    private IReadOnlyList<ApiError> Errors { get; set; } = [];

    private string? Message { get; set; }

    private bool IsLoading { get; set; }

    private int RequestVersion { get; set; }

    private bool IsExporting { get; set; }

    private bool IsSendingToSearchVolume { get; set; }

    private IReadOnlyList<KeywordCandidate> Candidates
        => DiscoveryResult?.Candidates ?? [];

    private IReadOnlyList<KeywordDiscoverySourceStatus> SourceStatuses
        => DiscoveryResult?.SourceStatuses ?? [];

    private bool CanRunDiscovery
        => ProjectState.SelectedProject is not null && !IsLoading;

    private bool CanSendCandidates
        => ProjectState.SelectedProject is not null && Candidates.Count > 0 && !IsSendingToSearchVolume;

    private bool CanExportCandidates
        => ProjectState.SelectedProject is not null && Candidates.Count > 0 && !IsExporting;

    private string LocationLanguageLabel
        => ProjectState.SelectedProject is { } project
            ? $"{UiText.Location(project.DefaultLocation)} / {UiText.Language(project.DefaultLanguage)}"
            : "プロジェクト未選択";

    private string CandidateCountLabel
        => Candidates.Count == 0 ? "0件" : $"{Candidates.Count:N0}件";

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await ProjectState.LoadAsync();
        SelectedProjectId = ProjectState.SelectedProject?.ProjectId;
        ProjectState.Changed += OnProjectStateChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        var query = $"{InitialProjectId}/{InitialJobId}";
        if (query == LoadedQuery) return;
        LoadedQuery = query;
        ++RequestVersion;
        Errors = [];
        Message = null;
        VolumeResultHref = null;
        IsLoading = IsSendingToSearchVolume = IsExporting = false;
        ApplyingQuery = true;
        var valid = await ProjectState.SelectFromQueryAsync(InitialProjectId);
        ApplyingQuery = false;
        if (!valid) { DiscoveryResult = null; DiscoveryJob = null; Errors = [new("Resource.NotFound", "指定されたプロジェクトは利用できません。")]; return; }
        DiscoveryResult = null;
        DiscoveryJob = null;
        // Like search volume, only guests reopen the latest result; signed-in users pick one from the history.
        if (string.IsNullOrWhiteSpace(InitialJobId)) { if (IsGuest) await LoadLatestDiscoveryAsync(); }
        else if (Guid.TryParse(InitialJobId, out var id)) await LoadDiscoveryJobAsync(id);
        else Errors = [new("Validation.JobId", "ジョブIDの形式を確認してください。")];
    }

    private async Task LoadLatestDiscoveryAsync()
    {
        if (ProjectState.SelectedProject is not { } project) return;
        var version = RequestVersion;
        var jobs = await ApiClient.SearchJobsAsync(projectId: project.ProjectId, jobType: "KeywordDiscoveryJob", pageSize: 1);
        if (version != RequestVersion || project.ProjectId != ProjectState.SelectedProject?.ProjectId) return;
        if (!jobs.IsSuccess) Errors = jobs.Errors;
        else if (jobs.Data?.FirstOrDefault() is { } job) await LoadDiscoveryJobAsync(job.JobId);
    }

    private async Task DiscoverAsync()
    {
        if (ProjectState.SelectedProject is not { } project || !ValidateDiscoveryForm())
        {
            return;
        }

        IsLoading = true;
        var requestVersion = ++RequestVersion;
        Errors = [];
        Message = null;
        VolumeResultHref = null;
        DiscoveryJob = null;
        DiscoveryResult = null;

        var request = new KeywordDiscoveryRequest(
            SeedKeyword: DiscoveryForm.SeedKeyword?.Trim(),
            Sources: DiscoveryForm.Sources.ToArray(),
            Engines: DiscoveryForm.Engines.ToArray(),
            Location: project.DefaultLocation,
            Language: project.DefaultLanguage,
            Limit: DiscoveryForm.Limit,
            Filter: BuildFilter(),
            SortBy: DiscoveryForm.SortBy,
            OrderBy: DiscoveryForm.OrderBy,
            SyncPreferred: DiscoveryForm.SyncPreferred);
        var result = await ApiClient.DiscoverKeywordsAsync(project.ProjectId, request);
        if (requestVersion != RequestVersion || project.ProjectId != ProjectState.SelectedProject?.ProjectId)
        {
            return;
        }
        if (result.IsSuccess && result.Data is { } discovery)
        {
            DiscoveryResult = discovery;
            if (discovery.IsAccepted && discovery.JobId.HasValue)
            {
                Message = $"探索ジョブを登録しました: {discovery.JobId.Value:D}";
                await LoadDiscoveryJobAsync(discovery.JobId.Value);
            }
            else
            {
                Message = $"{discovery.Candidates.Count:N0}件の候補語を保存しました。";
            }
        }
        else
        {
            Errors = result.Errors;
        }

        IsLoading = false;
        if (DiscoveryPanel is not null) await DiscoveryPanel.RefreshAsync();
    }

    private async Task RefreshDiscoveryJobAsync()
    {
        if (DiscoveryJob is not null)
        {
            await LoadDiscoveryJobAsync(DiscoveryJob.JobId);
        }
    }

    private async Task RetryDiscoveryJobAsync()
    {
        if (DiscoveryJob is not { Status: "failed_retryable" } job || job.ProjectId != ProjectState.SelectedProject?.ProjectId) return;
        var requestVersion = RequestVersion;
        var result = await ApiClient.RetryJobAsync(job.JobId);
        if (requestVersion != RequestVersion) return;
        if (result.IsSuccess) await LoadDiscoveryJobAsync(job.JobId);
        else Errors = result.Errors;
    }

    private async Task LoadDiscoveryJobAsync(Guid jobId)
    {
        if (ProjectState.SelectedProject is not { } project)
        {
            return;
        }
        var requestVersion = RequestVersion;
        var result = await ApiClient.GetJobAsync(jobId);
        if (requestVersion != RequestVersion || project.ProjectId != ProjectState.SelectedProject?.ProjectId)
        {
            return;
        }
        if (result.IsSuccess && result.Data is { } loadedJob && loadedJob.ProjectId == project.ProjectId && loadedJob.JobType == "KeywordDiscoveryJob")
        {
            DiscoveryJob = result.Data;
            if (DiscoveryJob is { Status: "succeeded" or "failed_retryable" or "failed_fatal" } && DiscoveryJob.ProjectId == project.ProjectId)
            {
                var results = await ApiClient.GetKeywordDiscoveryResultsAsync(project.ProjectId, jobId);
                if (requestVersion != RequestVersion || project.ProjectId != ProjectState.SelectedProject?.ProjectId)
                {
                    return;
                }
                if (results.IsSuccess)
                {
                    DiscoveryResult = results.Data;
                    if (results.Data?.SeedKeyword is { } seed) DiscoveryForm.SeedKeyword = seed;
                    Errors = [];
                }
                else
                {
                    Errors = results.Errors;
                }
            }
        }
        else
        {
            DiscoveryJob = null;
            DiscoveryResult = null;
            Errors = result.IsSuccess ? [new("Resource.NotFound", "選択中プロジェクトの探索結果が見つかりません。")] : result.Errors;
        }
    }

    private async Task RegisterCandidateSearchVolumeAsync()
    {
        if (ProjectState.SelectedProject is not { } project)
        {
            return;
        }

        var keywords = Candidates.Select(candidate => candidate.Keyword).Distinct(StringComparer.Ordinal).ToArray();
        if (keywords.Length == 0 || keywords.Length > KeywordInputParser.MaxKeywordCount)
        {
            Errors = [new ApiError("Validation.Keywords.Count", "候補語は1から50,000件で指定してください。", "keywords")];
            return;
        }

        IsSendingToSearchVolume = true;
        var requestVersion = RequestVersion;
        Errors = [];
        Message = null;
        VolumeResultHref = null;
        var result = await ApiClient.RegisterSearchVolumeJobAsync(
            project.ProjectId,
            new SearchVolumeJobRequest(keywords, project.DefaultLocation, project.DefaultLanguage));
        if (requestVersion != RequestVersion || project.ProjectId != ProjectState.SelectedProject?.ProjectId) return;
        if (result.IsSuccess && result.Data is { } job)
        {
            Message = "候補語の検索ボリューム調査を開始しました。";
            VolumeResultHref = $"/search-volume?projectId={project.ProjectId:D}&jobId={job.JobId:D}";
        }
        else
        {
            Errors = result.Errors;
        }

        IsSendingToSearchVolume = false;
    }

    private async Task CreateCandidateExportAsync()
    {
        if (ProjectState.SelectedProject is not { } project)
        {
            return;
        }

        IsExporting = true;
        Errors = [];
        Message = null;
        var filter = IsGuest && DiscoveryResult?.JobId is { } discoveryJobId
            ? JsonSerializer.SerializeToElement(new { jobId = discoveryJobId }, JsonOptions)
            : JsonSerializer.SerializeToElement(
            new
            {
                q = DiscoveryForm.SeedKeyword,
                source = DiscoveryForm.Sources.Count == 1 ? DiscoveryForm.Sources.Single() : null
            },
            JsonOptions);
        var result = await ApiClient.CreateCsvExportAsync(
            project.ProjectId,
            new DataExportRequest("keyword_candidates", filter));
        if (result.IsSuccess && result.Data is { } exportJob)
        {
            Message = "CSV出力を受け付けました。下のCSV出力欄からダウンロードできます。";
            if (ExportPanel is not null) await ExportPanel.RefreshAsync();
        }
        else
        {
            Errors = result.Errors;
        }

        IsExporting = false;
    }

    private KeywordDiscoveryFilter BuildFilter()
        => new(
            DiscoveryForm.MinSearchVolume,
            DiscoveryForm.MaxSearchVolume,
            DiscoveryForm.MinSeoDifficulty,
            DiscoveryForm.MaxSeoDifficulty,
            DiscoveryForm.MinCpc,
            DiscoveryForm.MaxCpc,
            DiscoveryForm.MinCompetition,
            DiscoveryForm.MaxCompetition,
            Optional(DiscoveryForm.FirstSeenRange),
            Optional(DiscoveryForm.SuggestClass),
            ParseTerms(DiscoveryForm.IncludeTerms),
            ParseTerms(DiscoveryForm.ExcludeTerms));

    private bool ValidateDiscoveryForm()
    {
        var errors = new List<ApiError>();
        if (ProjectState.SelectedProject is null)
        {
            errors.Add(new ApiError("Validation.Project.Required", "プロジェクトを選択してください。", "projectId"));
        }

        if (string.IsNullOrWhiteSpace(DiscoveryForm.SeedKeyword))
        {
            errors.Add(new ApiError("Validation.Keyword.Required", "シードキーワードを入力してください。", "seedKeyword"));
        }

        if (DiscoveryForm.Sources.Count == 0)
        {
            errors.Add(new ApiError("Validation.Sources.Required", "取得ソースを1つ以上選択してください。", "sources"));
        }

        if (DiscoveryForm.Engines.Count == 0)
        {
            errors.Add(new ApiError("Validation.Engines.Required", "検索エンジンを1つ以上選択してください。", "engines"));
        }

        if (DiscoveryForm.Limit is < 1 or > 25_000)
        {
            errors.Add(new ApiError("Validation.Limit.Range", "limitは1から25,000で指定してください。", "limit"));
        }

        Errors = errors;
        return errors.Count == 0;
    }

    private static void ToggleOption(HashSet<string> values, string value, ChangeEventArgs args)
    {
        var isChecked = args.Value is bool checkedValue
            ? checkedValue
            : bool.TryParse(args.Value?.ToString(), out var parsed) && parsed;
        if (isChecked)
        {
            values.Add(value);
        }
        else
        {
            values.Remove(value);
        }
    }

    private async void OnProjectStateChanged()
    {
        if (SelectedProjectId == ProjectState.SelectedProject?.ProjectId) return;
        SelectedProjectId = ProjectState.SelectedProject?.ProjectId;
        var loadLatest = !ApplyingQuery && IsGuest;
        await InvokeAsync(async () =>
        {
            RequestVersion++;
            DiscoveryResult = null;
            DiscoveryJob = null;
            Errors = [];
            Message = null;
            VolumeResultHref = null;
            IsLoading = false;
            IsSendingToSearchVolume = IsExporting = false;
            if (loadLatest) await LoadLatestDiscoveryAsync();
            StateHasChanged();
        });
    }

    private static IReadOnlyList<string>? ParseTerms(string? value)
    {
        var terms = string.IsNullOrWhiteSpace(value)
            ? []
            : value.Split([',', '\r', '\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Where(term => !string.IsNullOrWhiteSpace(term))
                .ToArray();
        return terms.Length == 0 ? null : terms;
    }

    private static string? Optional(string? value)
        => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private static string FormatNullable(decimal? value)
        => value.HasValue ? value.Value.ToString("0.####") : "-";

    public void Dispose()
    {
        RequestVersion++;
        ProjectState.Changed -= OnProjectStateChanged;
    }

    private sealed record OptionItem(string Value, string Label);

    private sealed class DiscoveryFormModel
    {
        public string? SeedKeyword { get; set; }

        public HashSet<string> Sources { get; } = new(["suggest", "related", "other", "question", "ranking"], StringComparer.Ordinal);

        public HashSet<string> Engines { get; } = new(["google"], StringComparer.Ordinal);

        public int? Limit { get; set; } = 100;

        public string SortBy { get; set; } = "searchVolume";

        public string OrderBy { get; set; } = "desc";

        public bool SyncPreferred { get; set; } = true;

        public decimal? MinSearchVolume { get; set; }

        public decimal? MaxSearchVolume { get; set; }

        public decimal? MinSeoDifficulty { get; set; }

        public decimal? MaxSeoDifficulty { get; set; }

        public decimal? MinCpc { get; set; }

        public decimal? MaxCpc { get; set; }

        public decimal? MinCompetition { get; set; }

        public decimal? MaxCompetition { get; set; }

        public string? FirstSeenRange { get; set; }

        public string? SuggestClass { get; set; }

        public string? IncludeTerms { get; set; }

        public string? ExcludeTerms { get; set; }
    }
}
